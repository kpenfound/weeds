type SgPoint {
  line: Int!
  column: Int!
}

type SgRange {
  start: SgPoint!
  end: SgPoint!
}

type SgMatch {
  file: String!
  ruleId: String!
  range: SgRange!
}

let commentMarkerRules: [String!]! = ["go-doc-candidate", "ts-doc-candidate"]

let commentIgnoredRules: [String!]! = ["unused-suppression"]


let commentLanguage(path: String!): String! {
  if (path.hasSuffix(".go")) {
    "go"
  } else {
    "ts"
  }
}

let commentBase(rule: String!): String! {
  rule.trimPrefix("go-").trimPrefix("ts-")
}

let commentPriority(rule: String!): Int! {
  case (commentBase(rule)) {
    "comment-todo" => 0
    "comment-main" => 1
    "comment-internal" => 2
    "comment-code" => 3
    "comment-not-doc" => 4
    "doc-candidate" => 5
    else => 99
  }
}

let commentMessage(base: String!): String! {
  case (base) {
    "comment-todo" => "TODO or FIXME comment; fix the code instead of leaving a note"
    "comment-main" => "comment in package main"
    "comment-internal" => "comment under internal/"
    "comment-code" => "commented-out code"
    "comment-not-doc" => "comment is not an adjacent doc comment on an exported identifier"
    "comment-trailing" => "trailing comment"
    "comment-blank-line" => "doc comment is separated from its declaration by a blank line"
    else => raise "no message for comment rule " + base
  }
}

let checkCommentRule(rule: String!): Boolean! {
  if (!commentsRules.contains(rule) and !commentMarkerRules.contains(rule) and !commentIgnoredRules.contains(rule)) {
    raise "comments: ast-grep reported rule " + quoted(rule) + " that is not registered; add it to commentsRules in registry.dang"
  }
  true
}

let commentLines(text: String!): [String!]! {
  text.replace("\r", "").split("\n")
}

let commentPositionKey(m: SgMatch!): String! {
  toString(m.range.start.line) + ":" + toString(m.range.start.column)
}

let leadingLength(lines: [String!]!): Int! {
  let i = 0
  let inBlock = false
  loop {
    if (i >= lines.length) {
      break
    }
    let t = lines[i]!.trimSpace
    if (inBlock) {
      if (t.contains("*/")) {
        inBlock = false
      }
      i += 1
    } else if (t == "" or t.hasPrefix("//") or (i == 0 and t.hasPrefix("#!"))) {
      i += 1
    } else if (t.hasPrefix("/*")) {
      if (!t.contains("*/")) {
        inBlock = true
      }
      i += 1
    } else {
      break
    }
  }
  i
}

let isGeneratedFile(lang: String!, lines: [String!]!): Boolean! {
  lines.takeFirst(leadingLength(lines)).any { row =>
    if (lang == "go") {
      row.containsMatch(`^// Code generated .* DO NOT EDIT\.$`)
    } else {
      row.containsMatch(`(?i)@generated|generated by`)
    }
  }
}

let licenceLine(row: String!): Boolean! {
  row.containsMatch(`(?i)^\s*(//+|/\*+!?|\*+|#)?\s*(@?copyright\b|\(c\)|©|spdx-license-identifier|@?licen[cs]e[ds]?\b|permission is hereby|all rights reserved|use of this source code)`)
}

let licenceHeaderLines(lines: [String!]!): [Int!]! {
  let rows = lines.takeFirst(leadingLength(lines))
  let licensedBlocks: Map[Boolean!]! = [:]
  let current = 0
  let blockOf = rows.map { row =>
    if (row.trimSpace == "") {
      current += 1
      -1
    } else {
      if (licenceLine(row)) {
        licensedBlocks = licensedBlocks.with(toString(current), true)
      }
      current
    }
  }
  blockOf
    .map { block, index => if (block >= 0 and licensedBlocks.has(toString(block))) { index + 1 } else { 0 } }
    .filter { number => number > 0 }
}

let isTrailingComment(lines: [String!]!, m: SgMatch!): Boolean! {
  let row = lines[m.range.start.line] ?? ""
  m.range.start.column > 0 and row.split("").takeFirst(m.range.start.column).join("").trimSpace != ""
}

let isAttachedDoc(lines: [String!]!, m: SgMatch!): Boolean! {
  let i = m.range.end.line + 1
  let attached = false
  loop {
    if (i >= lines.length) {
      break
    }
    let t = lines[i]!.trimSpace
    if (t == "") {
      break
    } else if (t.hasPrefix("//")) {
      i += 1
    } else if (t.hasPrefix("/*")) {
      loop {
        if (i >= lines.length or lines[i]!.contains("*/")) {
          break
        }
        i += 1
      }
      i += 1
    } else {
      attached = true
      break
    }
  }
  attached
}

let classifyComment(path: String!, lang: String!, lines: [String!]!, header: Map[Boolean!]!, m: SgMatch!): [Finding!]! {
  let line = m.range.start.line + 1
  let base = commentBase(m.ruleId)
  if (base == "comment-todo") {
    [Finding(path: path, line: line, rule: m.ruleId, message: commentMessage(base))]
  } else if (header.has(toString(line))) {
    []
  } else if (isTrailingComment(lines, m)) {
    [Finding(path: path, line: line, rule: lang + "-comment-detached", message: commentMessage("comment-trailing"))]
  } else if (base != "doc-candidate") {
    [Finding(path: path, line: line, rule: m.ruleId, message: commentMessage(base))]
  } else if ((lines[m.range.start.line] ?? "").contains("ast-grep-ignore")) {
    [Finding(path: path, line: line, rule: lang + "-comment-not-doc", message: commentMessage("comment-not-doc"))]
  } else if (isAttachedDoc(lines, m)) {
    []
  } else {
    [Finding(path: path, line: line, rule: lang + "-comment-detached", message: commentMessage("comment-blank-line"))]
  }
}

let commentFindings(path: String!, text: String!, found: [SgMatch!]!): [Finding!]! {
  let lang = commentLanguage(path)
  let lines = commentLines(text)
  if (isGeneratedFile(lang, lines)) {
    return []
  }
  let header: Map[Boolean!]! = [:]
  licenceHeaderLines(lines).each { number =>
    header = header.with(toString(number), true)
  }
  let best: Map[Int!]! = [:]
  found.each { m =>
    let key = commentPositionKey(m)
    let rank = commentPriority(m.ruleId)
    if (!best.has(key) or rank < best[key]!) {
      best = best.with(key, rank)
    }
  }
  concatFindings(
    found
      .filter { m => commentPriority(m.ruleId) == best[commentPositionKey(m)]! }
      .map { m => classifyComment(path, lang, lines, header, m) }
  )
}

let concatFindings(groups: [[Finding!]!]!): [Finding!]! {
  let total = groups.reduce(0) { count, group => count + group.length }
  if (total == 0) {
    return []
  }
  let which = 0
  let offset = 0
  "".padLeft(total).split("").map { slot =>
    loop {
      if (offset < groups[which]!.length) {
        break
      }
      which += 1
      offset = 0
    }
    let item = groups[which]![offset]!
    offset += 1
    item
  }
}

let commentFilesOf(matches: [SgMatch!]!): [String!]! {
  sortStrings(matches.map { m => m.file.trimPrefix("./") }.uniq)
}
