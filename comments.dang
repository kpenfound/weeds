type SgPoint {
  line: Int!
  column: Int!
}

type SgRange {
  start: SgPoint!
}

type SgMatch {
  file: String!
  ruleId: String!
  range: SgRange!
}

# Rule ids a scan reports that no weeds.toml exception names: the trailing and
# blank-line violations are reported as <lang>-comment-detached, and the
# generated-file and licence-header rules state facts about a file that
# suppress other matches.
let commentDetectorRules: [String!]! = ["go-comment-trailing", "go-comment-blank-line", "go-generated-file", "go-licence-header", "ts-comment-trailing", "ts-comment-blank-line", "ts-generated-file", "ts-licence-header"]

let commentIgnoredRules: [String!]! = ["unused-suppression"]

let commentLanguage(path: String!): String! {
  if (path.hasSuffix(".go")) {
    "go"
  } else {
    "ts"
  }
}

let commentBase(rule: String!): String! {
  rule.trimPrefix("go-").trimPrefix("ts-")
}

# The order in which rules that match one comment compete: the lowest wins.
# Facts about the file are not violations and have no rank.
let commentPriority(rule: String!): Int! {
  case (commentBase(rule)) {
    "comment-todo" => 0
    "comment-trailing" => 1
    "comment-main" => 2
    "comment-internal" => 3
    "comment-code" => 4
    "comment-not-doc" => 5
    "comment-blank-line" => 6
    else => 99
  }
}

let commentMessage(base: String!): String! {
  case (base) {
    "comment-todo" => "TODO or FIXME comment; fix the code instead of leaving a note"
    "comment-main" => "comment in package main"
    "comment-internal" => "comment under internal/"
    "comment-code" => "commented-out code"
    "comment-not-doc" => "comment is not an adjacent doc comment on an exported identifier"
    "comment-trailing" => "trailing comment"
    "comment-blank-line" => "doc comment is separated from its declaration by a blank line"
    else => raise "no message for comment rule " + base
  }
}

let checkCommentRule(rule: String!): Boolean! {
  if (!commentsRules.contains(rule) and !commentDetectorRules.contains(rule) and !commentIgnoredRules.contains(rule)) {
    raise "comments: ast-grep reported rule " + quoted(rule) + " that is not registered; add it to commentsRules in registry.dang"
  }
  true
}

let commentPositionKey(m: SgMatch!): String! {
  toString(m.range.start.line) + ":" + toString(m.range.start.column)
}

let commentFinding(path: String!, lang: String!, m: SgMatch!): Finding! {
  let base = commentBase(m.ruleId)
  let rule = if (base == "comment-trailing" or base == "comment-blank-line") {
    lang + "-comment-detached"
  } else {
    m.ruleId
  }
  Finding(path: path, line: m.range.start.line + 1, rule: rule, message: commentMessage(base))
}

# One file's findings from the matches ast-grep reported for it. A generated
# file has none. A licence header's comments are exempt, except a TODO or FIXME.
# When several rules match one comment the first in commentPriority is
# reported.
let commentFindings(path: String!, found: [SgMatch!]!): [Finding!]! {
  let lang = commentLanguage(path)
  let generated = false
  let header: Map[Boolean!]! = [:]
  let best: Map[Int!]! = [:]
  found.each { m =>
    let base = commentBase(m.ruleId)
    if (base == "generated-file") {
      generated = true
    } else if (base == "licence-header") {
      header = header.with(toString(m.range.start.line), true)
    } else {
      let key = commentPositionKey(m)
      let rank = commentPriority(m.ruleId)
      if (!best.has(key) or rank < best[key]!) {
        best = best.with(key, rank)
      }
    }
  }
  if (generated) {
    return []
  }
  found
    .filter { m => commentPriority(m.ruleId) == (best[commentPositionKey(m)] ?? -1) }
    .filter { m => commentBase(m.ruleId) == "comment-todo" or !header.has(toString(m.range.start.line)) }
    .map { m => commentFinding(path, lang, m) }
}

let concatFindings(groups: [[Finding!]!]!): [Finding!]! {
  let total = groups.reduce(0) { count, group => count + group.length }
  if (total == 0) {
    return []
  }
  let which = 0
  let offset = 0
  "".padLeft(total).split("").map { slot =>
    loop {
      if (offset < groups[which]!.length) {
        break
      }
      which += 1
      offset = 0
    }
    let item = groups[which]![offset]!
    offset += 1
    item
  }
}
