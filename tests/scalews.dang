let dNolint = "/" + "/nolint"

let dLintIgnore = "lint" + ":ignore"

let dEslint = "eslint" + "-disable"

let dExpectError = "@ts" + "-expect-error"

let dTsIgnore = "@ts" + "-ignore"

let dNoCheck = "@ts" + "-nocheck"

let dAstGrep = "ast-grep" + "-ignore"

let dNoqa = "# no" + "qa"

let wsFormRules: [String!]! = [dAstGrep, dEslint, "lint-ignore", "nolint", "noqa", "ts-expect-error", "ts-ignore", "ts-nocheck"]

let wsFormShown: [String!]! = [dAstGrep, dEslint, dLintIgnore, dNolint, dNoqa, dExpectError, dTsIgnore, dNoCheck]

let wsFormVariants: [[String!]!]! = [
  ["/" + "/ " + dAstGrep, "x = 1  # " + dAstGrep + " reason"]
  ["/* " + dEslint + " no-console */", "/" + "/ " + dEslint + "-next-line no-alert"]
  ["/" + "/ " + dLintIgnore + " SA1019 reason", "x := 1 " + "/" + "/ " + dLintIgnore + " U1000"]
  ["x := 1 " + dNolint + ":gosec", "y := 2 " + "/" + "/ no" + "lint", "z := 3 " + "/" + "/\tno" + "lint:errcheck"]
  ["import os  " + dNoqa, "import sys  # NO" + "QA", "x = 1  # No" + "Qa: E501", "y = 2  #no" + "qa", "z = 3  #   NO" + "QA"]
  ["/" + "/ " + dExpectError + " because", "/* " + dExpectError + " */"]
  ["/" + "/ " + dTsIgnore, "/* " + dTsIgnore + " */"]
  ["/" + "/ " + dNoCheck]
]

let wsExtensions: [String!]! = ["txt", "py", "sh", "yaml", "rb"]

let wsMessage(form: Int!): String! {
  "inline suppression " + wsFormShown[form]! + " is not allowed; fix the code, or name an exception in weeds.toml"
}

let wsRow(path: String!, line: Int!, form: Int!): String! {
  path + ":" + toString(line) + ": " + wsFormRules[form]! + ": " + wsMessage(form)
}

let wsBody(lines: Int!, at: Int!, text: String!): String! {
  scaleRange(lines).map { i => if (i + 1 == at) { text } else { "plain line " + toString(i + 1) + " of the file" } }.join("\n") + "\n"
}

let wsNearMisses: [String!]! = [
  "/" + "/nolinting here"
  "/" + "/nolint_x"
  "a/" + "/nolint2"
  "see the nolint docs"
  "# no" + "lint"
  "xlint" + ":ignore"
  "lint" + ":ignored"
  "mylint" + ":ignore"
  "myeslint" + "-disable"
  "eslint" + "-disabled"
  "@ts" + "-ignored"
  "@ts" + "-ignore2"
  "@ts" + "-expect-errors"
  "@ts" + "-nocheckx"
  "ast-grep" + "-ignored"
  "xast-grep" + "-ignore"
  "# no" + "qas"
  "#no" + "qa1"
  "# no qa"
  "noqa alone"
]

let wsFormFile(form: Int!, i: Int!): ScaleFile! {
  let variants = wsFormVariants[form]!
  let line = 1 + (i * 7 + form * 3) % 20
  let ext = wsExtensions[i % 5]!
  ScaleFile(path: "sup/" + wsFormRules[form]! + "/s" + pad3(i) + "." + ext, text: wsBody(20, line, variants[i % variants.length]!))
}

let wsFormRow(form: Int!, i: Int!): String! {
  let line = 1 + (i * 7 + form * 3) % 20
  wsRow("sup/" + wsFormRules[form]! + "/s" + pad3(i) + "." + wsExtensions[i % 5]!, line, form)
}

let wsMultiLine(i: Int!): Int! {
  1 + (i * 5) % 15
}

let wsMultiText(i: Int!): String! {
  case (i % 4) {
    0 => "a " + dNolint + " " + dEslint
    1 => "b " + dNolint + " again " + dNolint
    2 => dTsIgnore + " " + dNoCheck + " " + dEslint
    else => "x = 1  " + dNoqa + " " + dLintIgnore
  }
}

let wsMultiForms(i: Int!): [Int!]! {
  case (i % 4) {
    0 => [1, 3]
    1 => [3]
    2 => [1, 6, 7]
    else => [2, 4]
  }
}

let wsMultiPath(i: Int!): String! {
  "sup/multi/m" + pad3(i) + ".txt"
}

let wsFormCount = 12

let wsMultiCount = 12

let wsSkippedPlaces: [String!]! = [".git/hooks/h", "vendor/pkg", "node_modules/m", "sub/vendor/x", "a/b/node_modules/y"]

let wsFiller(count: Int!): [ScaleFile!]! {
  scaleRange(count).map { i =>
    let ext = ["txt", "json", "yaml", "cfg"][i % 4]!
    ScaleFile(path: "data/g" + pad2(i / 100) + "/n" + pad3(i % 1000) + "." + ext, text: "alpha " + toString(i) + "\nbeta = " + toString(i * 3) + "\nseed " + scaleSeed + "\nvalue: lint is a tool, ignore is a word\nplain text that holds no directive\nlast line\n")
  }
}

let wsSuppressionFiles: [ScaleFile!]! = scaleRange(8).map { form => scaleRange(wsFormCount).map { i => wsFormFile(form, i) } }.reduce([] :: [ScaleFile!]!) { all, part => all + part } +
  scaleRange(wsMultiCount).map { i => ScaleFile(path: wsMultiPath(i), text: wsBody(15, wsMultiLine(i), wsMultiText(i))) } +
  scaleRange(40).map { i =>
    ScaleFile(path: "near/n" + pad3(i) + ".txt", text: wsBody(10, 3, wsNearMisses[i % 20]!) + wsNearMisses[(i + 7) % 20]! + "\n" + wsNearMisses[(i + 13) % 20]! + "\n")
  } +
  scaleRange(10).map { i => ScaleFile(path: "generated/gen" + pad3(i) + ".txt", text: "/" + "/ Code generated by tool; DO NOT EDIT.\n" + wsBody(8, 5, wsFormVariants[i % 8]![0]!)) } +
  scaleRange(12).map { i => ScaleFile(path: ".hidden/h" + pad3(i) + ".txt", text: wsBody(9, 1 + i % 9, wsFormVariants[i % 8]![0]!)) } +
  scaleRange(10).map { i => ScaleFile(path: "build/out" + pad3(i) + ".txt", text: wsBody(9, 2 + i % 7, wsFormVariants[(i + 3) % 8]![0]!), skipped: true) } +
  scaleRange(10).map { i => ScaleFile(path: "logs/x" + pad3(i) + ".log", text: wsBody(9, 2 + i % 6, wsFormVariants[(i + 5) % 8]![0]!), skipped: true) } +
  scaleRange(12).map { i => ScaleFile(path: "scripts/s" + pad3(i) + ".py", text: "import os  " + dNoqa + "\nx = 1 " + dNolint + "\nprint(x)\n") } +
  scaleRange(15).map { i => ScaleFile(path: "legacy/l" + pad3(i) + ".txt", text: wsBody(6, 1 + i % 6, wsFormVariants[i % 8]![0]!)) } +
  [ScaleFile(path: ".agents/skills/custom/run.sh", text: "set -e\nrun " + dNolint + "\n")] +
  wsSkippedPlaces.map { place => scaleRange(6).map { i => ScaleFile(path: place + pad3(i) + "/f.txt", text: "x " + dNolint + "\n", skipped: true) } }.reduce([] :: [ScaleFile!]!) { all, part => all + part } +
  [ScaleFile(path: ".git/config", text: "[core]\n", skipped: true), ScaleFile(path: ".gitignore", text: "build/\n*.log\n")]

let wsSuppressionRows: [String!]! =
  [wsRow(".agents/skills/custom/run.sh", 2, 3)] +
  scaleRange(12).map { i => wsRow(".hidden/h" + pad3(i) + ".txt", 1 + i % 9, i % 8) } +
  scaleRange(10).map { i => wsRow("generated/gen" + pad3(i) + ".txt", 6, i % 8) } +
  scaleRange(12).map { i => wsRow("scripts/s" + pad3(i) + ".py", 2, 3) } +
  scaleRange(3).map { form => scaleRange(wsFormCount).map { i => wsFormRow(form, i) } }.reduce([] :: [String!]!) { all, part => all + part } +
  scaleRange(wsMultiCount).map { i => wsMultiForms(i).map { form => wsRow(wsMultiPath(i), wsMultiLine(i), form) } }.reduce([] :: [String!]!) { all, part => all + part } +
  [3, 4, 5, 6, 7].map { form => scaleRange(wsFormCount).map { i => wsFormRow(form, i) } }.reduce([] :: [String!]!) { all, part => all + part }

let wsException(key: String!, value: String!, paths: [String!]!, reason: String!): String! {
  tomlBlock("[[exceptions]]", [key + " = \"" + value + "\"", "paths = " + tomlList(paths), "reason = \"" + reason + "\""])
}

let wsAllowlist: [String!]! = ["planning/roadmap.md", "internal-docs/**", "TODO.md", "**/design-notes.md", "docs/**", "never/*.md"]

let wsToml: String! =
  wsException("check", "suppressions", ["legacy/**"], "scale: applies") +
  wsException("rule", "noqa", ["scripts/**"], "scale: applies") +
  wsException("check", "suppressions", ["archive/**"], "scale: stale") +
  wsException("rule", "ts-nocheck", ["nowhere/**"], "scale: stale") +
  wsException("check", "markdown", ["legacy-docs/**"], "scale: applies") +
  wsException("check", "markdown", ["old-docs/**"], "scale: stale") +
  wsException("check", "comments", ["legacy-go/**"], "scale: applies") +
  wsException("check", "comments", ["gone-go/**"], "scale: stale") +
  wsException("rule", "skill-added", [".agents/skills/simple-code/**"], "scale: applies") +
  wsException("check", "installed-skills", ["nothing/**"], "scale: stale") +
  "[markdown]\nallowlist = [\n" + wsAllowlist.map { entry => "  \"" + entry + "\"," }.join("\n") + "\n]\n"

let wsStaleSuppressions: [String!]! = [
  "weeds.toml:11: stale-exception: exception for check \"suppressions\" with paths archive/** matches no finding; remove it"
  "weeds.toml:16: stale-exception: exception for rule \"ts-nocheck\" with paths nowhere/** matches no finding; remove it"
]

let wsSuppressionsExpected: String! = joinedRows(wsSuppressionRows) + "\n" + wsStaleSuppressions.join("\n")

let wsMarkdownMessage = "internal markdown is not allowed; delete it, or name it in the weeds.toml markdown allowlist"

let wsMarkdownRow(path: String!): String! {
  path + ":1: internal-markdown: " + wsMarkdownMessage
}

let wsMarkdownFile(path: String!): ScaleFile! {
  ScaleFile(path: path, text: "notes in " + path + "\n")
}

let wsMarkdownReported: [String!]! =
  [".agents/skills/custom/NOTES.md", ".hidden/secret.md"] +
  scaleRange(5).map { i => "Notes/Upper" + pad3(i) + ".MD" } +
  scaleRange(20).map { i => "design/d" + pad3(i) + ".markdown" } +
  scaleRange(80).map { i => "notes/n" + pad3(i) + ".md" } +
  scaleRange(10).map { i => "rfc/r" + pad3(i) + ".mdx" }

let wsMarkdownSilent: [String!]! =
  ["AGENTS.md", "CHANGELOG.md", "CONTRIBUTING.md", "HISTORY.md", "LICENSE.md", "README.md", "RELEASE_NOTES.md", "Readme.MD", "sub/README.md", "sub/Changelog.md", "pkg/testdata/t.md", "TODO.md", "planning/roadmap.md", "a/design-notes.md", "a/b/design-notes.md"] +
  scaleRange(20).map { i => "docs/guide" + pad3(i) + ".md" } +
  scaleRange(10).map { i => "fixtures/f" + pad3(i) + ".md" } +
  scaleRange(30).map { i => "internal-docs/i" + pad3(i) + ".md" } +
  scaleRange(10).map { i => "legacy-docs/x" + pad3(i) + ".md" }

let wsMarkdownSkipped: [String!]! = ["vendor/x/README2.md", "node_modules/y/doc.md", "sub/vendor/z.md", ".git/notes.md", "build/out.md"]

let wsMarkdownFiles: [ScaleFile!]! =
  wsMarkdownReported.map { path => wsMarkdownFile(path) } +
  wsMarkdownSilent.map { path => wsMarkdownFile(path) } +
  wsMarkdownSkipped.map { path => ScaleFile(path: path, text: "skipped " + path + "\n", skipped: true) }

let wsMarkdownExpected: String! = joinedRows(wsMarkdownReported.map { path => wsMarkdownRow(path) }) + "\n" + [
  "weeds.toml:26: stale-exception: exception for check \"markdown\" with paths old-docs/** matches no finding; remove it"
  "weeds.toml:52: stale-allowlist: markdown allowlist entry \"docs/**\" matches no markdown file that needs it; remove it"
  "weeds.toml:52: stale-allowlist: markdown allowlist entry \"never/*.md\" matches no markdown file that needs it; remove it"
].join("\n")

let wsCommentRule(lang: String!, kind: String!): String! {
  case (kind) {
    "trailing" => lang + "-comment-detached"
    "blank" => lang + "-comment-detached"
    else => lang + "-comment-" + kind
  }
}

let wsCommentMessage(kind: String!): String! {
  case (kind) {
    "todo" => "TODO or FIXME comment; fix the code instead of leaving a note"
    "not-doc" => "comment is not an adjacent doc comment on an exported identifier"
    "code" => "commented-out code"
    "trailing" => "trailing comment"
    "blank" => "doc comment is separated from its declaration by a blank line"
    "main" => "comment in package main"
    else => "comment under internal/"
  }
}

let wsCommentRows(path: String!, lang: String!, marks: [[String!]!]!): [String!]! {
  marks.map { mark => path + ":" + mark[0]! + ": " + wsCommentRule(lang, mark[1]!) + ": " + wsCommentMessage(mark[1]!) }
}

let wsGoBanned: [[String!]!]! = [["3", "todo"], ["8", "not-doc"], ["13", "not-doc"], ["16", "code"], ["17", "code"], ["18", "code"], ["21", "trailing"], ["23", "blank"], ["27", "todo"], ["33", "not-doc"]]

let wsTsBanned: [[String!]!]! = [["1", "todo"], ["6", "not-doc"], ["11", "not-doc"], ["14", "code"], ["15", "code"], ["18", "trailing"], ["20", "blank"], ["24", "todo"], ["30", "not-doc"], ["32", "not-doc"], ["34", "not-doc"], ["38", "not-doc"], ["42", "not-doc"]]

let wsCommentFamily(dir: String!, name: String!, count: Int!, text: String!): [ScaleFile!]! {
  scaleRange(count).map { i => ScaleFile(path: dir + pad3(i) + "/" + name, text: text) }
}

