type Expectation {
  name: String!
  text: String! = ""
  fragments: [String!]! = []
  wantsError: Boolean! = false
}

type Outcome {
  failed: Boolean!
  text: String!
}

let fragmentLines(text: String!): [String!]! {
  text.split("\n").map { row => row.trimSpace }.filter { row => row != "" }
}

let missingFragments(fragments: [String!]!, text: String!): [String!]! {
  fragments.filter { f => !f.hasPrefix("!") and !text.contains(f) }
}

let forbiddenFragments(fragments: [String!]!, text: String!): [String!]! {
  fragments.filter { f => f.hasPrefix("!") and text.contains(f.trimPrefix("!")) }
}

let judge(expectation: Expectation!, outcome: Outcome!): String! {
  let head = "FAIL " + expectation.name + ": "
  if (expectation.wantsError and !outcome.failed) {
    head + "expected an error but the case succeeded with:\n" + outcome.text
  } else if (expectation.wantsError) {
    let missing = missingFragments(expectation.fragments, outcome.text)
    let forbidden = forbiddenFragments(expectation.fragments, outcome.text)
    if (!missing.isEmpty) {
      head + "error lacks expected fragment(s):\n  " + missing.join("\n  ") + "\nactual error:\n" + outcome.text
    } else if (!forbidden.isEmpty) {
      head + "error holds forbidden fragment(s):\n  " + forbidden.join("\n  ") + "\nactual error:\n" + outcome.text
    } else {
      ""
    }
  } else if (outcome.failed) {
    head + "expected output but got an error:\n" + outcome.text
  } else if (outcome.text.trimSpace != expectation.text.trimSpace) {
    head + "output differs\n--- expected\n" + expectation.text.trimSpace + "\n--- actual\n" + outcome.text.trimSpace
  } else {
    ""
  }
}

let summarize(verdicts: [String!]!): String! {
  let failures = verdicts.filter { verdict => verdict != "" }
  if (failures.isEmpty) {
    ""
  } else {
    toString(failures.length) + " of " + toString(verdicts.length) + " cases failed:\n\n" + failures.join("\n\n")
  }
}

let expect(ok: Boolean!, message: String!): Void {
  if (!ok) {
    raise message
  }
  null
}

let escapeBody(text: String!): String! {
  text.replace("\\", "\\\\").replace("\n", "\\n")
}

let describeChanges(changes: Changeset!): String! {
  let rows: [String!]! = []
  changes.addedPaths.filter { path => !path.hasSuffix("/") }.each { path =>
    rows += ["+ " + path + " " + escapeBody(changes.after.file(path).contents)]
  }
  changes.modifiedPaths.filter { path => !path.hasSuffix("/") }.each { path =>
    rows += ["~ " + path + " " + escapeBody(changes.after.file(path).contents)]
  }
  changes.removedPaths.each { path =>
    if (path.hasSuffix("/")) {
      let folder = path.trimSuffix("/")
      changes.before.directory(folder).glob("**/*").filter { inner => !inner.hasSuffix("/") }.each { inner =>
        rows += ["- " + folder + "/" + inner]
      }
    } else {
      rows += ["- " + path]
    }
  }
  if (rows.isEmpty) {
    "no change"
  } else {
    sortRows(rows).join("\n")
  }
}

let sortRows(rows: [String!]!): [String!]! {
  rows.reduce([] :: [String!]!) { sorted, row =>
    let before = sorted.filter { other => other <= row }
    let after = sorted.filter { other => other > row }
    before + [row] + after
  }
}

let quoted(text: String!): String! {
  "\"" + text + "\""
}

let checkResult(check: Check!): String! {
  if (check.pass) {
    "passed"
  } else {
    check.error.message ?? "the check failed without a message"
  }
}

# Fixture workspaces cannot hold live ignore files or a .git directory without
# changing the repository's own scans. A fixture names them with a .fixture
# suffix and the harness renames them when the case runs:
#   gitignore.fixture, ignore.fixture, rgignore.fixture -> .gitignore, .ignore, .rgignore
#     in the same directory, at any depth
#   git-info-exclude.fixture (root only) -> .git/info/exclude
# Every workspace then gets a .git/HEAD marker: ripgrep applies .gitignore only
# inside a git repository, and a .git entry is all it looks for.
let liveIgnoreTarget(path: String!): String! {
  let parts = path.split("/")
  let name = parts[parts.length - 1]!
  let parent = parts.dropLast.join("/")
  let live = case (name) {
    "gitignore.fixture" => ".gitignore"
    "ignore.fixture" => ".ignore"
    "rgignore.fixture" => ".rgignore"
    "git-info-exclude.fixture" => if (parts.length == 1) { ".git/info/exclude" } else { "" }
    else => ""
  }
  if (live == "" or parent == "") {
    live
  } else {
    parent + "/" + live
  }
}

let liveIgnoreFiles(base: Directory!): Directory! {
  base.glob("**/*.fixture").map { path => path.trimPrefix("./") }.filter { path => liveIgnoreTarget(path) != "" }.reduce(base) { dir, path =>
    dir.withFile(liveIgnoreTarget(path), base.file(path)).withoutFile(path)
  }
}

let gitMarked(base: Directory!): Directory! {
  if (base.exists(".git/HEAD")) {
    base
  } else {
    base.withNewFile(".git/HEAD", "ref: refs/heads/main\n")
  }
}

let ignoreAware(base: Directory!): Directory! {
  gitMarked(liveIgnoreFiles(base))
}

let sameList(label: String!, want: [String!]!, got: [String!]!): Void {
  expect(want.join("\n") == got.join("\n"), label + " differs\n--- expected\n" + want.join("\n") + "\n--- actual\n" + got.join("\n"))
}
