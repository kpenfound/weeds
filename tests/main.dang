"""
Fixture and harness tests for Weeds. A suite is a directory of cases under
tests/fixtures; each case holds a workspace plus expected.txt (compared
exactly after trimming) or expected-error.txt (one fragment per line that the
failure must contain; a leading ! marks a fragment it must not contain).
"""
type WeedsTests {
  let fixtures: Directory!
  let hostWorkspace: Workspace!
  let generatorSource: File!

  new(ws: Workspace!) {
    self.fixtures = ws.directory("/tests/fixtures")
    self.hostWorkspace = ws
    self.generatorSource = ws.file("/skills.dang")
    self
  }

  """
  Workspace.search and Workspace.directory on workspaces built from
  directories, which the shared file layer is built on: without a .git entry
  ripgrep honours .ignore and .rgignore but not .gitignore; with one it honours
  all three, nested files included, and .git/info/exclude either way; the
  directory upload's gitignore option reads .gitignore only; a positive search
  glob re-includes ignored files while a negated one does not; a files-only
  search never lists an empty file or a file with NUL bytes; a multiline search
  for the start of the text yields one result with one submatch per non-empty
  text file.
  """
  pub ignoreProbes: Void @check {
    let plain = needleTree(directory).asWorkspace
    let headed = needleTree(directory.withNewFile(".git/HEAD", gitHead)).asWorkspace
    expect(searchedPaths(plain, true, []) == ".hidden.txt git-ignored.txt other/nested-git.txt plain.txt sub/git-ignored.txt sub/nested-git.txt sub/plain.txt", "without .git, search must honour .ignore and .rgignore but not .gitignore, got: " + searchedPaths(plain, true, []))
    expect(searchedPaths(headed, true, []) == ".hidden.txt other/nested-git.txt plain.txt sub/plain.txt", "with a .git entry, search must honour .gitignore, .ignore and .rgignore, nested ones included, got: " + searchedPaths(headed, true, []))
    expect(searchedPaths(headed, false, []).contains("git-ignored.txt") and searchedPaths(headed, false, []).contains("sub/nested-rg.txt"), "without skipIgnored, search must return ignored files")

    let uploaded = uploadedPaths(plain.directory("/", gitignore: true))
    expect(uploaded == ".gitignore .hidden.txt .ignore .rgignore dot-ignored.txt other/nested-git.txt plain.txt rg-ignored.txt sub/.gitignore sub/.ignore sub/.rgignore sub/nested-dot.txt sub/nested-rg.txt sub/plain.txt", "the upload's gitignore option must apply .gitignore files only, got: " + uploaded)

    let excluded = excludeTree(directory.withNewFile(".git/HEAD", gitHead))
    expect(searchedPaths(excluded.asWorkspace, true, []) == "control.txt", "search must honour .git/info/exclude, got: " + searchedPaths(excluded.asWorkspace, true, []))
    expect(searchedPaths(excludeTree(directory).asWorkspace, true, []) == "control.txt", "search must honour .git/info/exclude without a HEAD file, got: " + searchedPaths(excludeTree(directory).asWorkspace, true, []))
    let excludedUpload = uploadedPaths(excluded.asWorkspace.directory("/", gitignore: true))
    expect(excludedUpload.contains("excluded.txt") and excludedUpload.contains("sub/excluded-sub.txt"), "the upload's gitignore option must not apply .git/info/exclude, got: " + excludedUpload)

    let included = searchedPaths(headed, true, ["*.txt"])
    expect(included.contains("git-ignored.txt") and included.contains("sub/nested-rg.txt"), "a positive search glob must re-include ignored files, got: " + included)
    expect(searchedPaths(headed, true, ["!sub/**"]) == ".hidden.txt other/nested-git.txt plain.txt", "a negated search glob must keep ignore rules, got: " + searchedPaths(headed, true, ["!sub/**"]))

    expect(filesOnlyPaths(kindsTree().asWorkspace) == "newline.txt nonl.txt text.txt", "a files-only search must skip empty files and files with NUL bytes, got: " + filesOnlyPaths(kindsTree().asWorkspace))
    sameList("the one-result-per-file search", ["newline.txt:1:1", "nonl.txt:1:1", "text.txt:1:1"], oneResultPerFile(kindsTree().asWorkspace))
    null
  }

  """
  Config loading, validation and the shared exception evaluator.
  """
  pub config: Void @check {
    runSuite("config")
  }

  """
  The harness's own comparison behaviour, on in-memory cases.
  """
  pub harness: Void @check {
    let exact = judge(Expectation(name: "exact", text: "a\nb"), Outcome(failed: false, text: "a\nb"))
    expect(exact == "", "a matching output must pass, got: " + exact)

    let trimmed = judge(Expectation(name: "trimmed", text: "a\nb\n"), Outcome(failed: false, text: "\na\nb"))
    expect(trimmed == "", "surrounding whitespace must not matter, got: " + trimmed)

    let mismatch = judge(Expectation(name: "deliberate-mismatch", text: "one"), Outcome(failed: false, text: "two"))
    expect(mismatch.contains("FAIL deliberate-mismatch"), "a mismatch must fail naming the case, got: " + mismatch)
    expect(mismatch.contains("one") and mismatch.contains("two"), "a mismatch must show both texts, got: " + mismatch)

    let inner = judge(Expectation(name: "inner-space", text: "a  b"), Outcome(failed: false, text: "a b"))
    expect(inner != "", "inner whitespace must be compared exactly")

    let fragments = Expectation(name: "fragments", fragments: ["alpha", "beta", "!gamma"], wantsError: true)
    expect(judge(fragments, Outcome(failed: true, text: "alpha and beta")) == "", "an error holding every fragment must pass")
    let lacking = judge(fragments, Outcome(failed: true, text: "alpha only"))
    expect(lacking.contains("beta") and lacking.contains("lacks"), "a missing fragment must be named, got: " + lacking)
    let forbidden = judge(fragments, Outcome(failed: true, text: "alpha beta gamma"))
    expect(forbidden.contains("forbidden") and forbidden.contains("!gamma"), "a forbidden fragment must fail, got: " + forbidden)

    let unexpectedSuccess = judge(fragments, Outcome(failed: false, text: "fine"))
    expect(unexpectedSuccess.contains("expected an error"), "success where an error is expected must fail, got: " + unexpectedSuccess)
    let unexpectedError = judge(Expectation(name: "boom", text: "fine"), Outcome(failed: true, text: "kaboom"))
    expect(unexpectedError.contains("expected output") and unexpectedError.contains("kaboom"), "an error where output is expected must fail, got: " + unexpectedError)

    let all = summarize([exact, mismatch, lacking, trimmed, inner])
    expect(all.contains("3 of 5 cases failed"), "failures must be counted together, got: " + all)
    expect(all.contains("deliberate-mismatch") and all.contains("inner-space") and all.contains("fragments"), "every failure must be reported together, got: " + all)
    expect(summarize([exact, trimmed]) == "", "no failures must give an empty summary")

    expect(fragmentLines("  a  \n\n b\n") == ["a", "b"], "fragment lines must be trimmed and non-empty")
    null
  }

  """
  Findings render as path:line: rule: message in one deterministic order.
  """
  pub findings: Void @check {
    let unsorted = "b.go:3: zeta: last\na.go:10: alpha: later line\na.go:9: beta: same line, second rule\na.go:9: alpha: same line, first rule\nb.go:3: zeta: first"
    let expected = "a.go:9: alpha: same line, first rule\na.go:9: beta: same line, second rule\na.go:10: alpha: later line\nb.go:3: zeta: first\nb.go:3: zeta: last"
    let shared = weeds(ws: directory.withNewFile("README.md", "x\n").asWorkspace)
    let once = shared.sortedFindings(unsorted)
    expect(once == expected, "findings must sort by path, numeric line, rule, message; got:\n" + once)
    expect(shared.sortedFindings(unsorted) == once, "sorting the same findings twice must give identical output")
    expect(shared.sortedFindings(expected) == expected, "sorted findings must stay as they are")
    let rejected = { shared.sortedFindings("not a finding"); "accepted" } rescue { err: Error => err.message }
    expect(rejected.contains("not a finding line"), "a malformed line must be rejected, got: " + rejected)

    let inOrder = ["a", "a-b", "a/b", "b"].map { path =>
      [1, 2, 9, 10, 100].map { line =>
        ["alpha", "alpha2", "beta"].map { rule =>
          ["m", "m2"].map { message =>
            let row = path + ":" + toString(line) + ": " + rule + ": " + message
            if (line == 9) { row + "\n" + row } else { row }
          }.join("\n")
        }.join("\n")
      }.join("\n")
    }.join("\n").split("\n")
    let shuffled = scaleRange(inOrder.length).map { slot, i => inOrder[(i * 37 + 11) % inOrder.length]! }
    expect(shuffled.join("\n") != inOrder.join("\n"), "the shuffle must change the order")
    sameText("the findings sorted from a shuffled input", inOrder.join("\n"), shared.sortedFindings(shuffled.join("\n")))
    null
  }

  """
  weeds.toml path globs.
  """
  pub globs: Void @check {
    let shared = weeds(ws: directory.withNewFile("README.md", "x\n").asWorkspace)
    expect(shared.globMatches("tests/fixtures/**", "tests/fixtures/a/b.txt"), "** must match any depth")
    expect(shared.globMatches("tests/fixtures", "tests/fixtures/a/b.txt"), "a directory path must cover everything under it")
    expect(shared.globMatches("**/x.go", "x.go") and shared.globMatches("**/x.go", "a/b/x.go"), "**/ must match zero or more directories")
    expect(shared.globMatches("*.md", "b.md"), "* must match within a segment")
    expect(!shared.globMatches("*.md", "a/b.md"), "* must not cross a slash")
    expect(shared.globMatches("a?c", "abc") and !shared.globMatches("a?c", "a/c"), "? must match one non-slash character")
    expect(!shared.globMatches("a.b", "aXb"), "a dot must be literal")
    expect(!shared.globMatches("src", "srcs/a.go"), "a name must not match a longer sibling name")
    null
  }

  """
  The scanning listing skips .git, vendor, node_modules and Weeds-owned skill
  folders, lists hidden files and leaves out files an ignore file matches, and
  the module's workspace stays whole.
  """
  pub walk: Void @check {
    let marker = weeds(ws: directory.withNewFile("README.md", "x\n").asWorkspace).ownerMarker
    let tree = directory
      .withNewFile(".git/config", "git\n")
      .withNewFile("vendor/pkg/a.go", "vendor\n")
      .withNewFile("node_modules/m/index.js", "module\n")
      .withNewFile("sub/node_modules/z.js", "nested module\n")
      .withNewFile("sub/vendor/y.go", "nested vendor\n")
      .withNewFile(".agents/skills/owned/SKILL.md", "skill\n")
      .withNewFile(".agents/skills/owned/.weeds-managed", marker)
      .withNewFile(".agents/skills/owned/refs/deep.md", "deep\n")
      .withNewFile(".agents/skills/unmarked/SKILL.md", "unmarked\n")
      .withNewFile(".claude/skills/imposter/SKILL.md", "imposter\n")
      .withNewFile(".claude/skills/imposter/.weeds-managed", "someone else\n")
      .withNewFile(".hidden/file.txt", "hidden\n")
      .withNewFile(".gitignore", "ignored.log\n")
      .withNewFile("ignored.log", "ignored\n")
      .withNewFile("src/main.go", "package main\n")
    let w = weeds(ws: tree.asWorkspace)
    let walked = w.scanFiles.join("\n")
    let expected = ".agents/skills/unmarked/SKILL.md\n.claude/skills/imposter/.weeds-managed\n.claude/skills/imposter/SKILL.md\n.gitignore\n.hidden/file.txt\nsrc/main.go"
    expect(walked == expected, "the walk must skip .git, vendor, node_modules, owned skill folders and ignored files; got:\n" + walked)
    expect(w.scanFiles.join("\n") == walked, "walking twice must give identical output")
    expect(w.ownedFolders == [".agents/skills/owned"], "only a folder with a valid marker is owned, got: " + w.ownedFolders.join(", "))
    expect(w.source.file(".agents/skills/owned/.weeds-managed").contents == marker, "the workspace must keep the owned marker")
    expect(w.source.file(".agents/skills/owned/SKILL.md").contents == "skill\n", "the workspace must keep owned skill files")
    expect(w.source.file(".agents/skills/owned/refs/deep.md").contents == "deep\n", "the workspace must keep owned nested files")
    expect(w.source.file("ignored.log").contents == "ignored\n", "the workspace must keep ignored files")
    expect(w.source.exists(".git/config") and w.source.exists("vendor/pkg/a.go") and w.source.exists("node_modules/m/index.js"), "the workspace must keep .git, vendor and node_modules")
    null
  }

  """
  A file matched by .gitignore, .ignore, .rgignore, a nested ignore file or
  .git/info/exclude is left out of the listing, of search results and of an
  upload, which all hold the same files. Hidden files that are not ignored,
  and the ignore files themselves, stay. The skipped names and an owned skill
  folder stay out too.
  """
  pub scanIgnored: Void @check {
    let w = ignoreSubject
    let listed = [".gitignore", ".hidden/kept.txt", ".ignore", ".rgignore", "kept.go", "kept.txt", "other/nested-git.txt", "sub/.gitignore", "sub/.ignore", "sub/.rgignore", "sub/kept.txt"]
    expect(listed.length > 0 and w.scanFiles.length == listed.length, "the scan of a fixture with known files must not be empty")
    sameList("scanFiles", listed, w.scanFiles)
    sameList("the files of a search for any character", listed, sortRows(w.searchRows(".", []).map { row => row.split(":")[0]! }.uniq))
    sameList("the files in the upload", listed, w.uploadedFiles([]))
    sameList("the files the upload was built from", listed, w.uploadList([]))
    expect(w.ownedFolders == [".agents/skills/owned"], "the owned skill folder must be found from its marker, got: " + w.ownedFolders.join(", "))
    null
  }

  """
  The search helper returns only lines in files that match its include globs,
  and the upload helper only files that match them, each with ignore files
  applied. A glob-restricted search or upload does not evaluate scanFiles.
  """
  pub fileLayer: Void @check {
    let w = ignoreSubject
    sameList("a search for needle", [".hidden/kept.txt:1", "kept.txt:1", "other/nested-git.txt:1", "sub/kept.txt:1"], sortRows(w.searchRows("needle", [])))
    sameList("a search under sub", ["sub/kept.txt:1"], sortRows(w.searchRows("needle", ["sub/**"])))
    sameList("a search of root text files", ["kept.txt:1"], sortRows(w.searchRows("needle", ["*.txt"])))
    sameList("a search of Go files", ["kept.go:3"], sortRows(w.searchRows("Needle", ["**/*.go"])))
    sameList("a search of two globs", ["kept.go:3", "sub/kept.txt:1"], sortRows(w.searchRows("(?i)needle", ["**/*.go", "sub/**"])))
    sameList("a search of root text files in any case", ["kept.txt:1"], sortRows(w.searchRows("needle", ["*.[tT][xX][tT]"])))
    sameList("the upload of Go files in any case", ["kept.go"], w.uploadedFiles(["**/*.[gG][oO]"]))
    sameList("a search of an ignored file's name", [], w.searchRows("Needle", ["rg-ignored.go", "git-ignored.txt", "build/**"]))
    sameList("the Go upload", ["kept.go"], w.uploadedFiles(["**/*.go"]))
    sameList("the Go upload's list", ["kept.go"], w.uploadList(["**/*.go"]))
    sameList("the text upload", [".hidden/kept.txt", "kept.txt", "other/nested-git.txt", "sub/kept.txt"], w.uploadedFiles(["**/*.txt"]))
    sameList("the hidden upload", [".hidden/kept.txt"], w.uploadedFiles([".hidden/**"]))
    sameList("an upload no file matches", [], w.uploadedFiles(["**/*.rs"]))
    expect(w.hostHasRipgrep, "the engine-side search of a fixture workspace must be backed by ripgrep")
    expect(w.ripgrepGuard([1, 3, 1]) == "ok", "results with submatches must pass the ripgrep guard")
    expect(w.ripgrepGuard([]) == "ok", "no results must pass the ripgrep guard")
    let bare = w.ripgrepGuard([1, 0])
    expect(bare.contains("ripgrep") and bare.contains("ignore"), "results without submatches must fail naming ripgrep, got: " + bare)

    let odd = directory
      .withNewFile(".git/HEAD", gitHead)
      .withNewFile(".gitignore", "a1.txt\nweird.txt\nqx.txt\nd1.txt\n")
      .withNewFile("a[1].txt", "x\n").withNewFile("a1.txt", "x\n")
      .withNewFile("we*ird.txt", "x\n").withNewFile("weird.txt", "x\n")
      .withNewFile("q?.txt", "x\n").withNewFile("qx.txt", "x\n")
      .withNewFile("d{1}.txt", "x\n").withNewFile("d1.txt", "x\n")
      .withNewFile("!bang.txt", "x\n")
      .withNewFile("sp ace.txt", "x\n")
      .withNewFile("back\\slash.txt", "x\n")
      .withNewFile("sub/#hash.txt", "x\n")
    let oddFiles = ["!bang.txt", ".gitignore", "a[1].txt", "back\\slash.txt", "d{1}.txt", "q?.txt", "sp ace.txt", "sub/#hash.txt", "we*ird.txt"]
    sameList("the listing of odd names", oddFiles, weeds(ws: odd.asWorkspace).scanFiles)
    sameList("the upload of odd names, which must not match ignored look-alikes", oddFiles, weeds(ws: odd.asWorkspace).uploadedFiles([]))
    null
  }

  """
  The listing helper includes the empty files that the search never lists, but
  not one an ignore file or .git/info/exclude hides, nor a text file hidden
  that way: markdown candidates from every repository ignore source. The
  upload helper's support files bring in files the search never lists (empty
  or binary) from a direct upload with .gitignore applied.
  """
  pub listedWithEmpty: Void @check {
    let w = weeds(ws: markdownWorkspace.asWorkspace)
    sameList("the markdown listing", [".hidden/empty.md", "empty.md", "kept.md", "sub/empty.md"], w.listedFiles(["**/*.md"]))
    sameList("the listing under sub", ["sub/.gitignore", "sub/.ignore", "sub/.rgignore", "sub/empty.md", "sub/kept.txt"], w.listedFiles(["sub/**"]))
    sameList("the markdown listing under sub", ["sub/empty.md"], w.listedFiles(["sub/*.md"]))
    sameList("a listing no file matches", [], w.listedFiles(["**/*.rs"]))
    sameList("the upload without support", ["kept.go"], w.uploadedFiles(["**/*.go"]))
    sameList("the upload with support files", ["data/blob.bin", "data/empty.dat", "kept.go"], w.supportUploadedFiles(["**/*.go"], ["data/**"]))
    sameList("the support upload leaves out gitignored files", ["kept.go"], w.supportUploadedFiles(["**/*.go"], ["build/**"]))
    null
  }

  let markdownWorkspace: Directory! {
    ignoreWorkspace
      .withNewFile("kept.md", "text\n")
      .withNewFile("empty.md", "")
      .withNewFile("sub/empty.md", "")
      .withNewFile(".hidden/empty.md", "")
      .withNewFile("dot-ignored.md", "")
      .withNewFile("git-ignored.md", "")
      .withNewFile("rg-ignored.md", "")
      .withNewFile("info-excluded.md", "")
      .withNewFile("sub/nested-dot.md", "")
      .withNewFile("sub/nested-git.md", "")
      .withNewFile("sub/nested-rg.md", "")
      .withNewFile("build/empty.md", "")
      .withNewFile("vendor/empty.md", "")
      .withNewFile("node_modules/empty.md", "")
      .withNewFile("data/empty.dat", "")
      .withNewFile("data/blob.bin", "\u0000\u0001")
  }

  let ignoreSubject: Weeds! {
    weeds(ws: ignoreWorkspace.asWorkspace)
  }

  let ignoreWorkspace: Directory! {
    let marker = weeds(ws: directory.withNewFile("README.md", "x\n").asWorkspace).ownerMarker
    materialize(fixtures.directory("ignore-probe"))
      .withNewFile(".git/config", "git\n")
      .withNewFile(".agents/skills/owned/SKILL.md", "needle\n")
      .withNewFile(".agents/skills/owned/.weeds-managed", marker)
  }

  """
  What a workspace on this machine's disk gives: the files of an upload and
  the files of a search, with ignore rules applied, for the manual
  global-excludes evidence kept under tests/fixtures/ignore-probe. Run it from a
  scratch workspace.
  """
  pub rawHost(pattern: String!, glob: String!): String! {
    let globs = if (glob == "") { [] :: [String!]! } else { [glob] }
    hostWorkspace.search(pattern: pattern, skipIgnored: true, globs: globs).{{filePath, submatches.{{start}}}}.map { r => r.filePath + "[" + toString(r.submatches.length) + "]" }.join(" ")
  }

  """
  The same workspace through the search helper, the shared upload helper and a
  plain Workspace.directory upload with its gitignore option, for the manual
  global-excludes evidence. Run it from a scratch workspace.
  """
  pub hostIgnoreReport(pattern: String!): String! {
    let w = weeds(ws: hostWorkspace)
    let plain = sortRows(hostWorkspace.directory("/", include: ["**/*.dat"], gitignore: true).glob("**/*").map { path => path.trimPrefix("./") }.filter { path => !path.hasSuffix("/") })
    "search: " + w.searchRows(pattern, []).join(" ") + "\nshared upload: " + w.uploadedFiles(["**/*.dat"]).join(" ") + "\nplain upload with gitignore: " + plain.join(" ")
  }

  """
  The suppressions check over fixture workspaces: each directive, hidden and
  gitignored files, skipped locations, named exceptions.
  """
  pub suppressions: Void @check {
    runSuite("suppressions")
  }

  """
  The markdown check over fixture workspaces: always-allowed categories, the
  allowlist, stale entries and skills-looking folders without a marker.
  """
  pub markdown: Void @check {
    runSuite("markdown")
  }

  """
  The suppressions scan skips .git, vendor, node_modules and an owned skill
  folder, but reads a skills-looking folder whose marker is wrong. The
  directive text is built at run time so this file holds none.
  """
  pub suppressionsSkips: Void @check {
    let marker = weeds(ws: directory.withNewFile("README.md", "x\n").asWorkspace).ownerMarker
    let directive = "/" + "/nolint\n"
    let tree = directory
      .withNewFile(".git/hooks/pre-commit", directive)
      .withNewFile("vendor/pkg/a.go", directive)
      .withNewFile("node_modules/m/index.js", directive)
      .withNewFile("sub/vendor/b.go", directive)
      .withNewFile(".agents/skills/owned/SKILL.md", directive)
      .withNewFile(".agents/skills/owned/.weeds-managed", marker)
      .withNewFile(".claude/skills/imposter/SKILL.md", directive)
      .withNewFile(".claude/skills/imposter/.weeds-managed", "someone else\n")
      .withNewFile("src/main.go", "package main\n")
    let report = weeds(ws: tree.asWorkspace).suppressionsReport
    let expected = ".claude/skills/imposter/SKILL.md:1: nolint: inline suppression /" + "/nolint is not allowed; fix the code, or name an exception in weeds.toml"
    expect(report == expected, "only the unmarked folder may be reported; got:\n" + report)
    null
  }

  """
  The comments check on fixture workspaces: Go and TS/JS, allowed and banned
  forms, overlaps, grammars and a consumer ast-grep configuration.
  """
  pub comments: Void @check {
    runSuite("comments")
  }

  """
  The comments check's Dang logic on in-memory ast-grep matches (lines count
  from 0 in the original file): which rule wins when several match one
  comment, how the trailing and blank-line violations are reported, licence
  headers, generated files, and rule registration.
  """
  pub commentLogic: Void @check {
    let shared = weeds(ws: directory.withNewFile("README.md", "x\n").asWorkspace)

    let unknown = { shared.classifyComments("a.go", sgMatches([sgMatch("go-comment-made-up", 0, 0)])); "accepted" } rescue { err: Error => err.message }
    expect(unknown.contains("go-comment-made-up") and unknown.contains("not registered"), "an unregistered rule id must fail loudly, got: " + unknown)
    expect(shared.classifyComments("a.go", sgMatches([sgMatch("unused-suppression", 1, 0)])) == "", "ast-grep's built-in unused-suppression must be ignored")
    expect(shared.classifyComments("a.go", "[]") == "", "a file whose comments all comply has no match and no finding")

    let layers = sgMatches([sgMatch("go-comment-blank-line", 1, 0), sgMatch("go-comment-not-doc", 1, 0), sgMatch("go-comment-main", 1, 0)])
    expect(shared.classifyComments("a.go", layers) == "a.go:2: go-comment-main: comment in package main", "one comment must give one finding, the most specific rule winning")
    let notDocWins = sgMatches([sgMatch("go-comment-blank-line", 1, 0), sgMatch("go-comment-not-doc", 1, 0)])
    expect(shared.classifyComments("a.go", notDocWins) == "a.go:2: go-comment-not-doc: comment is not an adjacent doc comment on an exported identifier", "not-doc must win over the blank-line violation")
    let todoWins = sgMatches([sgMatch("go-comment-main", 1, 0), sgMatch("go-comment-todo", 1, 0), sgMatch("go-comment-trailing", 1, 0)])
    expect(shared.classifyComments("a.go", todoWins) == "a.go:2: go-comment-todo: TODO or FIXME comment; fix the code instead of leaving a note", "TODO must win over a location rule and the trailing rule, got: " + shared.classifyComments("a.go", todoWins))
    let twoOnALine = sgMatches([sgMatch("go-comment-main", 1, 0), sgMatch("go-comment-trailing", 1, 12)])
    expect(shared.classifyComments("a.go", twoOnALine) == "a.go:2: go-comment-detached: trailing comment\na.go:2: go-comment-main: comment in package main", "each comment on a line is judged by its own matches")
    let trailingWins = sgMatches([sgMatch("go-comment-main", 1, 12), sgMatch("go-comment-trailing", 1, 12), sgMatch("go-comment-not-doc", 1, 12)])
    expect(shared.classifyComments("a.go", trailingWins) == "a.go:2: go-comment-detached: trailing comment", "a trailing comment is detached whatever else it breaks, got: " + shared.classifyComments("a.go", trailingWins))

    let gap = shared.classifyComments("a.go", sgMatches([sgMatch("go-comment-blank-line", 1, 0)]))
    expect(gap == "a.go:2: go-comment-detached: doc comment is separated from its declaration by a blank line", "a blank line detaches a doc comment, got: " + gap)
    let blockGap = shared.classifyComments("a.ts", sgMatches([sgMatch("ts-comment-blank-line", 0, 0)]))
    expect(blockGap == "a.ts:1: ts-comment-detached: doc comment is separated from its declaration by a blank line", "a doc block is reported at its first line, got: " + blockGap)
    let trailing = shared.classifyComments("a.go", sgMatches([sgMatch("go-comment-trailing", 1, 12)]))
    expect(trailing == "a.go:2: go-comment-detached: trailing comment", "a trailing comment is detached, got: " + trailing)

    let header = sgMatches([sgMatch("go-comment-main", 0, 0), sgMatch("go-comment-main", 1, 0), sgMatch("go-licence-header", 0, 0), sgMatch("go-licence-header", 1, 0)])
    expect(shared.classifyComments("a.go", header) == "", "a licence header passes in package main")
    let beyondHeader = sgMatches([sgMatch("go-comment-main", 3, 0), sgMatch("go-licence-header", 0, 0), sgMatch("go-licence-header", 1, 0)])
    expect(shared.classifyComments("a.go", beyondHeader) == "a.go:4: go-comment-main: comment in package main", "only the lines of the header are exempt")
    let headerTodo = sgMatches([sgMatch("go-comment-todo", 1, 0), sgMatch("go-comment-main", 1, 0), sgMatch("go-licence-header", 0, 0), sgMatch("go-licence-header", 1, 0)])
    expect(shared.classifyComments("a.go", headerTodo) == "a.go:2: go-comment-todo: TODO or FIXME comment; fix the code instead of leaving a note", "a TODO inside a licence header is reported")
    let headerTrailing = sgMatches([sgMatch("ts-comment-trailing", 0, 4), sgMatch("ts-licence-header", 0, 4)])
    expect(shared.classifyComments("a.ts", headerTrailing) == "", "a licence header comment is exempt from the trailing rule")

    let generated = sgMatches([sgMatch("go-generated-file", 0, 0), sgMatch("go-comment-todo", 2, 0), sgMatch("go-comment-not-doc", 3, 0)])
    expect(shared.classifyComments("g.go", generated) == "", "a generated Go file has no findings")
    expect(shared.classifyComments("g.ts", sgMatches([sgMatch("ts-comment-todo", 1, 0), sgMatch("ts-generated-file", 0, 0)])) == "", "a generated TS file has no findings")
    expect(shared.classifyComments("g.go", sgMatches([sgMatch("go-comment-todo", 2, 0)])) != "", "without a generated-file match a TODO is reported")
    expect(shared.classifyComments("g.go", sgMatches([sgMatch("go-generated-file", 0, 0), sgMatch("go-licence-header", 1, 0)])) == "", "facts about a file are not findings")

    let ignored = shared.classifyComments("a.go", sgMatches([sgMatch("go-comment-not-doc", 1, 0)]))
    expect(ignored == "a.go:2: go-comment-not-doc: comment is not an adjacent doc comment on an exported identifier", "a not-doc comment is reported under go-comment-not-doc, got: " + ignored)
    null
  }

  """
  The go-lint check over fixture workspaces, through the real golangci-lint
  image: every finding category across several Go modules, a consumer
  golangci-lint config that must change nothing, the baseline and exceptions.
  """
  pub golint: Void @check {
    runSuite("golint")
  }

  """
  The golangci-lint image is pinned by an exact tag and a sha256 digest, never
  latest.
  """
  pub golintPin: Void @check {
    let ref = weeds(ws: directory.withNewFile("README.md", "x\n").asWorkspace).goLintImageRef
    expect(ref.containsMatch(`^[a-z0-9./-]+:v[0-9]+\.[0-9]+\.[0-9]+@sha256:[0-9a-f]{64}$`), "the image must carry an exact vX.Y.Z tag and a sha256 digest, got: " + ref)
    expect(!ref.contains("latest"), "the image must not follow latest, got: " + ref)
    null
  }

  """
  Every rule file in the comment packs has a rule test and a snapshot, every
  scanned rule id is registered, and ast-grep's rule tests pass for the Go,
  TypeScript and derived TSX packs.
  """
  pub ruleTests: Void @check {
    let shared = weeds(ws: directory.withNewFile("README.md", "x\n").asWorkspace)
    let goRules = shared.goRules
    let typescriptRules = shared.typescriptRules
    let tsxRules = shared.tsxRules
    let problems = ruleFileGaps("rules/go", goRules) + ruleFileGaps("rules/typescript", typescriptRules) + ruleFileGaps("tsx", tsxRules)
    let scanned = shared.commentScanRules
    (ruleIdsOf(goRules) + ruleIdsOf(typescriptRules)).each { id =>
      if (!scanned.contains(id)) {
        problems += ["rule " + id + " is not registered in registry.dang (commentsRules) or comments.dang (commentDetectorRules)"]
      }
    }
    scanned.each { id =>
      if (!id.hasSuffix("-detached") and !ruleIdsOf(goRules).contains(id) and !ruleIdsOf(typescriptRules).contains(id)) {
        problems += ["scanned comments rule " + id + " has no rule file"]
      }
    }
    if (!problems.isEmpty) {
      raise "rule test gaps:\n- " + problems.join("\n- ")
    }
    let tool = shared.astGrep
    let reports = [runRuleTests(tool, goRules), runRuleTests(tool, typescriptRules), runRuleTests(tool, tsxRules)]
    reports.each { report =>
      expect(report.contains("passed; 0 failed") and !report.contains("FAIL"), "ast-grep rule tests did not pass:\n" + report)
    }
    null
  }

  """
  The generated preset enables the correctness, dead-code, godox and
  complexity linters and nothing else, and never lets golangci-lint cap or
  merge issues.
  """
  pub golintPreset: Void @check {
    let preset = weeds(ws: directory.withNewFile("README.md", "x\n").asWorkspace).goLintPresetText
    expect(preset.contains("default: none"), "the preset must start from no linters, got:\n" + preset)
    let enabled = ["errcheck", "govet", "ineffassign", "staticcheck", "unused", "godox", "funlen", "gocognit", "nestif", "dupl"]
    enabled.each { name =>
      expect(preset.contains("    - " + name + "\n"), "the preset must enable " + name + ", got:\n" + preset)
    }
    expect(preset.contains("uniq-by-line: false") and preset.contains("max-issues-per-linter: 0") and preset.contains("max-same-issues: 0"), "the preset must report every issue, got:\n" + preset)
    null
  }

  """
  The rule-test gap detector fails on a rule without a test, without a
  snapshot, or whose file name differs from its id.
  """
  pub ruleTestGaps: Void @check {
    let complete = directory
      .withNewFile("rules/a.yml", "id: a\nlanguage: Go\n")
      .withNewFile("tests/a-test.yml", "id: a\n")
      .withNewFile("tests/__snapshots__/a-snapshot.yml", "id: a\n")
    expect(ruleFileGaps("pack", complete).isEmpty, "a rule with a test and a snapshot has no gap")
    let noTest = complete.withNewFile("rules/b.yml", "id: b\n").withNewFile("tests/__snapshots__/b-snapshot.yml", "id: b\n")
    let noTestGaps = ruleFileGaps("pack", noTest).join("\n")
    expect(noTestGaps.contains("rule b has no rule test"), "a missing test must be reported, got: " + noTestGaps)
    let noSnapshot = complete.withNewFile("rules/c.yml", "id: c\n").withNewFile("tests/c-test.yml", "id: c\n")
    let noSnapshotGaps = ruleFileGaps("pack", noSnapshot).join("\n")
    expect(noSnapshotGaps.contains("rule c has no snapshot"), "a missing snapshot must be reported, got: " + noSnapshotGaps)
    let wrongId = complete.withNewFile("rules/d.yml", "id: other\n").withNewFile("tests/d-test.yml", "id: d\n").withNewFile("tests/__snapshots__/d-snapshot.yml", "id: d\n")
    let wrongIdGaps = ruleFileGaps("pack", wrongId).join("\n")
    expect(wrongIdGaps.contains("rules/d.yml must declare id: d"), "a file name that differs from its id must be reported, got: " + wrongIdGaps)
    null
  }

  """
  go-lint runs once per go.mod outside vendor, testdata and node_modules,
  skipping a module that holds no Go files and one that lives only in a
  directory an ignore file, .git/info/exclude or .gitignore leaves out.
  """
  pub golintModules: Void @check {
    let tree = directory
      .withNewFile("go.mod", "module root\n")
      .withNewFile("main.go", "package main\n")
      .withNewFile("a/go.mod", "module a\n")
      .withNewFile("a/x.go", "package a\n")
      .withNewFile("a/b/go.mod", "module b\n")
      .withNewFile("a/b/y.go", "package b\n")
      .withNewFile("tools/go.mod", "module tools\n")
      .withNewFile("tools/notes.txt", "no Go here\n")
      .withNewFile("only-testdata/go.mod", "module t\n")
      .withNewFile("only-testdata/testdata/z.go", "package z\n")
      .withNewFile("testdata/m/go.mod", "module m\n")
      .withNewFile("testdata/m/m.go", "package m\n")
      .withNewFile("vendor/v/go.mod", "module v\n")
      .withNewFile("vendor/v/v.go", "package v\n")
      .withNewFile("node_modules/n/go.mod", "module n\n")
      .withNewFile("node_modules/n/n.go", "package n\n")
      .withNewFile("outer/go.mod", "module outer\n")
      .withNewFile("outer/inner/go.mod", "module inner\n")
      .withNewFile("outer/inner/i.go", "package inner\n")
      .withNewFile(".gitignore", "worktrees/\n")
      .withNewFile(".rgignore", "scratch/\n")
      .withNewFile("worktrees/copy/go.mod", "module copy\n")
      .withNewFile("worktrees/copy/c.go", "package copy\n")
      .withNewFile("scratch/go.mod", "module scratch\n")
      .withNewFile("scratch/s.go", "package scratch\n")
      .withNewFile("a/.ignore", "hidden/\n")
      .withNewFile("a/hidden/go.mod", "module hidden\n")
      .withNewFile("a/hidden/h.go", "package hidden\n")
      .withNewFile(".git/info/exclude", "private/\n")
      .withNewFile("private/go.mod", "module private\n")
      .withNewFile("private/p.go", "package private\n")
    let modules = weeds(ws: gitMarked(tree).asWorkspace).goLintModules.join(",")
    expect(modules == ".,a,a/b,outer/inner", "go-lint must lint each module that holds Go files, once, and none that only an ignored directory holds; got: " + modules)
    null
  }

  """
  The installer's golden changesets over fixture workspaces and fixture skill
  trees: targets, ownership, replacement, removal and source validation.
  """
  pub generate: Void @check {
    runSuite("generate")
  }

  """
  The installed-skills check over fixture workspaces and fixture skill trees.
  """
  pub installedSkills: Void @check {
    runSuite("installed-skills")
  }

  """
  Through the real installed-skills check: it passes on generator output,
  fails naming every path a hand edit changed in either target, passes with
  nothing to install, and fails naming an unmarked folder. Also, the real
  generator restores a hand-edited owned folder.
  """
  pub installedSkillsEntryPoint: Void @check {
    let tree = installedWorkspace(directory.withNewFile("weeds.toml", "[skills]\nsubset = [\"no-deltas\", \"unslop\"]\n"), skillSource("full"))
    let clean = weeds(ws: tree.asWorkspace, skillSource: skillSource("full"))
    expect(checkResult(clean.installedSkills) == "passed", "the check must pass on generator output, got: " + checkResult(clean.installedSkills))
    let edited = tree
      .withNewFile(".claude/skills/no-deltas/SKILL.md", "hand edited\n")
      .withNewFile(".agents/skills/unslop/extra.txt", "extra\n")
      .withoutFile(".agents/skills/no-deltas/SKILL.md")
    let broken = weeds(ws: edited.asWorkspace, skillSource: skillSource("full"))
    let failure = checkResult(broken.installedSkills)
    ["skill-modified", ".claude/skills/no-deltas/SKILL.md", "skill-removed", ".agents/skills/unslop/extra.txt", "skill-added", ".agents/skills/no-deltas/SKILL.md"].each { part =>
      expect(failure.contains(part), "the check must report " + part + ", got: " + failure)
    }
    let restored = broken.generate.after
    expect(restored.file(".claude/skills/no-deltas/SKILL.md").contents == skillSource("full").file("no-deltas/SKILL.md").contents, "generate must restore a hand-edited owned file")
    expect(!restored.exists(".agents/skills/unslop/extra.txt"), "generate must remove an extra file from an owned folder")
    expect(restored.exists(".agents/skills/no-deltas/SKILL.md"), "generate must restore a deleted file in an owned folder")
    let afterGenerate = checkResult(weeds(ws: restored.asWorkspace, skillSource: skillSource("full")).installedSkills)
    expect(afterGenerate == "passed", "the check must pass after generate, got: " + afterGenerate)

    let nothing = weeds(ws: directory.withNewFile("README.md", "x\n").asWorkspace, skillSource: skillSource("full"))
    expect(checkResult(nothing.installedSkills) == "passed", "the check must pass with nothing to install")
    expect(nothing.installedSkillsReport == "no findings", "nothing to install must report no findings")
    let refused = { nothing.generate.addedPaths.join(","); "generated" } rescue { err: Error => err.message }
    expect(refused.contains("nowhere to install skills"), "generate must fail where the check passes, got: " + refused)

    let conflict = weeds(ws: directory.withNewFile("AGENTS.md", "x\n").withNewFile(".agents/skills/unslop/SKILL.md", "mine\n").asWorkspace, skillSource: skillSource("full"))
    let conflictFailure = checkResult(conflict.installedSkills)
    expect(conflictFailure.contains(".agents/skills/unslop") and conflictFailure.contains("skill-conflict"), "an unmarked folder must fail the check naming it, got: " + conflictFailure)
    null
  }

  """
  One consumer-like workspace that uses every weeds.toml section, through the
  real entry points of all five checks and the installer: findings from each
  check, an exception, an allowlisted markdown file, a baselined complexity
  finding, a subset install, and a hand-edited owned skill folder that the
  scans skip while installed-skills reports it and generate restores it.
  """
  pub consumer: Void @check {
    runSuite("consumer")
  }

  """
  A module that does not build cannot be linted: go-lint raises instead of
  passing. The broken module is built here so no committed fixture breaks the
  repository's own go-lint run.
  """
  pub golintBuildFailure: Void @check {
    let tree = directory
      .withNewFile("go.mod", "module example.com/broken\n\ngo 1.22\n")
      .withNewFile("broken.go", "package broken\n\nfunc Value() int {\n\treturn missing\n}\n")
    let outcome = { weeds(ws: tree.asWorkspace).goLintReport } rescue { err: Error => err.message }
    expect(outcome.contains("go-lint: golangci-lint could not build module . (the workspace root)"), "a build failure must raise naming the module, got: " + outcome)
    expect(outcome.contains("undefined: missing"), "the build error must be shown, got: " + outcome)
    null
  }

  """
  Every go-lint raise keeps its exact text, through the validation code the
  check itself runs on golangci-lint's process result: non-zero exit status,
  unreadable JSON, a missing or unreadable Issues list, and the explicit null
  that means no findings.
  """
  pub golintRaises: Void @check {
    lintVerdicts(lintProcessCases + lintReadableCases + lintIssuesFieldCases)
  }

  """
  The boundaries go-lint draws on one issue: a missing or wrong-typed
  FromLinter, Text, Pos.Filename and Pos.Line, accepted and rejected line
  values, build failures, unregistered linters and files outside the
  workspace, each with its exact result.
  """
  pub golintBoundaries: Void @check {
    lintVerdicts(lintMissingFieldCases + lintLineCases + lintTypedFieldCases + lintTypecheckCases)
  }

  """
  Finding text, linter names and file names come out of golangci-lint's JSON
  with the escapes Weeds has always understood and every other escape left as
  typed, including a backslash before n.
  """
  pub golintEscapes: Void @check {
    lintVerdicts(lintEscapeCases)
  }

  """
  A thousand golangci-lint issues across fifty Go files through the go-lint
  validation, symbol lookup, baseline, exception and ordering code, with the
  exact rendered report derived from how the issues were generated.
  """
  pub scaleGolint: Void @check {
    let subject = weeds(ws: goScaleTree("", scaleRootFiles).asWorkspace)
    sameText("the go-lint report", goScaleExpected("", scaleRootFiles), subject.goLintReportFromResult(".", 0, goScaleOutput("", scaleRootFiles), ""))
  }

  """
  Another thousand issues in a nested module: finding paths and the
  duplicate-of text are re-prefixed with the module directory.
  """
  pub scaleGolintNested: Void @check {
    let subject = weeds(ws: goScaleTree("svc/api/", 50).asWorkspace)
    sameText("the nested module go-lint report", goScaleExpected("svc/api/", 50), subject.goLintReportFromResult("svc/api", 0, goScaleOutput("svc/api/", 50), ""))
  }

  """
  A workspace of about five thousand in-memory files: the suppressions check
  finds every directive form, near-misses and case variants in hidden and
  gitignored files, skips .git, vendor, node_modules and owned skill folders,
  and applies exceptions; the exact report is derived from the generator.
  """
  pub scaleSuppressions: Void @check {
    let subject = scaleSubject
    let nonSkipped = wsAllFiles.filter { f => !f.skipped }.length
    expect(subject.scanFiles.length == nonSkipped, "the scan must see " + toString(nonSkipped) + " files, got " + toString(subject.scanFiles.length))
    sameText("the suppressions report", wsSuppressionsExpected, subject.suppressionsReport)
  }

  """
  The same workspace through the markdown check: always-allowed markdown, the
  allowlist with its stale entries, exceptions and skipped folders.
  """
  pub scaleMarkdown: Void @check {
    sameText("the markdown report", wsMarkdownExpected, scaleSubject.markdownReport)
  }

  """
  The same workspace through the comments check with real ast-grep: Go and TS
  files with every comment rule, generated files, licence headers, an
  exception and skipped folders.
  """
  pub scaleComments: Void @check {
    sameText("the comments report", wsCommentsExpected, scaleSubject.commentsReport)
  }

  """
  The same workspace through installed-skills, with a real skills target
  installed from the fixed fake skill source: owned folders, a hand edit, a
  missing file, a deselected owned folder, missing skills and exceptions.
  """
  pub scaleInstalledSkills: Void @check {
    let subject = scaleSubject
    sameText("the installed-skills report", wsInstalledExpected, subject.installedSkillsReport)
    sameText("the installed-skills check", wsInstalledExpected, checkResult(subject.installedSkills))
  }

  """
  The skills pin is a full 40-character SHA and the installer holds no branch,
  tag, latest or credential token. The validator is tested on in-memory text
  first, then applied to skills.dang.
  """
  pub skillsPin: Void @check {
    let sha = "2210631f5dfab54241980a94b1ff3b21460328df"
    let good = "let skillsRepository = \"https://github.com/kpenfound/skills\"\n\nlet skillsCommit = \"" + sha + "\"\n\nlet fetchSkills(): Directory! {\n  git(skillsRepository).commit(skillsCommit).tree\n}\n"
    expect(pinProblems(good).isEmpty, "a full SHA pin must pass, got: " + pinProblems(good).join("; "))
    ["main", "v1.2.3", "latest", "2210631f5dfab54241980a94b1ff3b21460328d", sha + "0", "2210631F5DFAB54241980A94B1FF3B21460328DF", "2210631f5dfab54241980a94b1ff3b21460328dg", ""].each { bad =>
      let problems = pinProblems(good.replace(sha, bad))
      expect(problems.any { p => p.contains("40-character") }, "pin " + quoted(bad) + " must be rejected, got: " + problems.join("; "))
    }
    expect(!pinProblems("let skillsRepository = \"https://github.com/kpenfound/skills\"\n").isEmpty, "a missing pin line must be rejected")
    expect(!pinProblems(good.replace("https://github.com/kpenfound/skills", "https://user@github.com/kpenfound/skills")).isEmpty, "a repository URL with user info must be rejected")
    expect(!pinProblems(good.replace("https://github.com/kpenfound/skills", "https://github.com/other/skills")).isEmpty, "another repository must be rejected")
    pinTokens.each { word =>
      let problems = pinProblems(good + "let x = fetch" + word + "()\n")
      expect(problems.any { p => p.contains(quoted(word)) }, "token " + quoted(word) + " must be rejected, got: " + problems.join("; "))
    }
    let real = pinProblems(generatorSource.contents)
    expect(real.isEmpty, "skills.dang must pin a full SHA with no lookup or credential tokens:\n- " + real.join("\n- "))
    null
  }

  let lintVerdicts(cases: [LintCase!]!): Void {
    let tree = directory.withNewFile("a.go", lintWorkspaceSource).withNewFile("svc/api/a.go", lintWorkspaceSource)
    let subject = weeds(ws: tree.asWorkspace)
    let failures = cases.map { c =>
      let got = { subject.goLintReportFromResult(c.module, c.status, c.stdout, c.stderr) } rescue { err: Error => lintFailed(lintPlain(err.message)) }
      if (got == c.want) { "" } else { "FAIL " + c.name + ":\n  expected: " + c.want + "\n  actual:   " + got }
    }.filter { verdict => verdict != "" }
    if (!failures.isEmpty) {
      raise toString(failures.length) + " of " + toString(cases.length) + " go-lint cases failed:\n\n" + failures.join("\n\n")
    }
    null
  }

  let scaleSubject: Weeds! {
    weeds(ws: scaleWorkspace.asWorkspace, skillSource: skillSource("full"))
  }

  let scaleWorkspace: Directory! {
    let marker = "github.com/kpenfound/weeds\n"
    let source = skillSource("full")
    let installed = ["behavioral-testing", "no-comments", "no-deltas", "unslop"].reduce(assembleTree(wsAllFiles)) { dir, name =>
      dir
        .withDirectory(".agents/skills/" + name, source.directory(name))
        .withNewFile(".agents/skills/" + name + "/.weeds-managed", marker)
    }
    installed
      .withNewFile(".agents/skills/no-deltas/SKILL.md", wsSkillHandEdit)
      .withNewFile(".agents/skills/no-deltas/notes.txt", "extra\n")
      .withoutFile(".agents/skills/unslop/SKILL.md")
      .withNewFile(".agents/skills/legacy-skill/.weeds-managed", marker)
      .withNewFile(".agents/skills/legacy-skill/a.txt", "a\n")
      .withNewFile(".agents/skills/legacy-skill/sub/b.txt", "b\n")
  }

  let skillSource(name: String!): Directory! {
    fixtures.directory("skill-sources/" + name)
  }

  let installedWorkspace(base: Directory!, tree: Directory!): Directory! {
    let names = ["no-deltas", "unslop"]
    [".agents/skills", ".claude/skills"].reduce(base) { dir, target =>
      names.reduce(dir) { inner, name =>
        inner
          .withDirectory(target + "/" + name, tree.directory(name))
          .withNewFile(target + "/" + name + "/.weeds-managed", "github.com/kpenfound/weeds\n")
      }
    }
  }

  let ownedFolders(base: Directory!, tree: Directory!, names: [String!]!): Directory! {
    names.reduce(base) { dir, name =>
      dir
        .withDirectory(".agents/skills/" + name, tree.directory(name))
        .withNewFile(".agents/skills/" + name + "/.weeds-managed", "github.com/kpenfound/weeds\n")
    }
  }

  let consumerReport(caseDir: Directory!, workspace: Directory!): String! {
    let source = skillSource("full")
    let tree = ownedFolders(workspace, source, ["no-deltas", "unslop", "no-comments"])
      .withDirectory(".agents/skills/no-deltas", caseDir.directory("hand-edits"))
    let subject = weeds(ws: tree.asWorkspace, skillSource: source)
    let scans = [
      section("comments", checkResult(subject.comments))
      section("suppressions", checkResult(subject.suppressions))
      section("markdown", checkResult(subject.markdown))
    ]
    scans.each { scan =>
      expect(!scan.contains(".agents/skills"), "the scans must skip the owned skill folder, got:\n" + scan)
    }
    let installed = section("installed-skills", checkResult(subject.installedSkills))
    ["SKILL.md", "helper.ts", "extra.md"].each { name =>
      expect(installed.contains(".agents/skills/no-deltas/" + name), "installed-skills must report the hand edit to " + name + ", got:\n" + installed)
    }
    let changes = subject.generate
    let restored = weeds(ws: changes.after.asWorkspace, skillSource: source)
    expect(restored.installedSkillsReport == "no findings", "generate must restore every owned folder, got:\n" + restored.installedSkillsReport)
    (scans + [section("go-lint", checkResult(subject.goLint)), installed, section("generate", describeChanges(changes))]).join("\n\n")
  }

  let section(name: String!, body: String!): String! {
    "== " + name + " ==\n" + body
  }

  let runSuite(suite: String!): Void {
    let names = fixtures.entries(path: suite).map { entry => entry.trimSuffix("/") }
    if (names.isEmpty) {
      raise "suite " + suite + " has no cases"
    }
    let message = summarize(names.map { name => runCase(suite, name) })
    if (message != "") {
      raise message
    }
    null
  }

  let runCase(suite: String!, name: String!): String! {
    let label = suite + "/" + name
    let caseDir = fixtures.directory(label)
    let wantsOutput = caseDir.exists("expected.txt")
    let wantsError = caseDir.exists("expected-error.txt")
    if (wantsOutput == wantsError) {
      return "FAIL " + label + ": a case needs exactly one of expected.txt and expected-error.txt"
    }
    let expectation = Expectation(
      name: label
      text: if (wantsOutput) { caseDir.file("expected.txt").contents } else { "" }
      fragments: if (wantsError) { fragmentLines(caseDir.file("expected-error.txt").contents) } else { [] }
      wantsError: wantsError
    )
    judge(expectation, attempt(suite, caseDir))
  }

  let attempt(suite: String!, caseDir: Directory!): Outcome! {
    { Outcome(failed: false, text: reportFor(suite, caseDir, materialize(caseDir))) } rescue {
      err: Error => Outcome(failed: true, text: err.message)
    }
  }

  let materialize(caseDir: Directory!): Directory! {
    let named = ignoreAware(caseDir.directory("workspace"))
    if (caseDir.exists("symlinks.txt")) {
      fragmentLines(caseDir.file("symlinks.txt").contents).reduce(named) { dir, row =>
        let parts = row.split(" -> ")
        dir.withSymlink(parts[1]!.trimSpace, parts[0]!.trimSpace)
      }
    } else {
      named
    }
  }

  let reportFor(suite: String!, caseDir: Directory!, workspace: Directory!): String! {
    let source = if (caseDir.exists("source.txt")) { caseDir.file("source.txt").contents.trimSpace } else { "full" }
    let subject = weeds(ws: workspace.asWorkspace, skillSource: skillSource(source))
    case (suite) {
      "config" => if (caseDir.exists("findings.txt")) {
        let lines = caseDir.file("findings.txt").contents.split("\n")
        if (!lines[0]!.hasPrefix("check:")) {
          raise "findings.txt must start with a check: line"
        }
        subject.evaluateCheck(lines[0]!.trimPrefix("check:").trimSpace, lines.dropFirst(1).join("\n"))
      } else {
        subject.settingsReport
      }
      "suppressions" => subject.suppressionsReport
      "markdown" => subject.markdownReport
      "comments" => subject.commentsReport
      "golint" => subject.goLintReport
      "generate" => describeChanges(subject.generate)
      "consumer" => consumerReport(caseDir, workspace)
      "installed-skills" => {
        let report = subject.installedSkillsReport
        let passed = subject.installedSkills.pass
        if (passed != (report == "no findings")) {
          raise "the installed-skills check and its report disagree: check passed " + toString(passed) + ", report:\n" + report
        }
        report
      }
      else => raise "no report is registered for suite " + suite
    }
  }
}
