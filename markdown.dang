let markdownRule = "internal-markdown"

let markdownExtensions: [String!]! = [".md", ".markdown", ".mdx"]

# Include globs for the markdown files, with each letter of the extension in
# both cases: Workspace.directory include patterns are case-sensitive, and
# isMarkdownPath matches the extension in any case.
let caseInsensitive(text: String!): String! {
  text.split("").map { ch =>
    if (ch.toLower != ch.toUpper) { "[" + ch.toLower + ch.toUpper + "]" } else { ch }
  }.join("")
}

let markdownGlobs: [String!]! = markdownExtensions.map { ext => "**/*" + caseInsensitive(ext) }

let allowedMarkdownStems: [String!]! = [
  "readme"
  "agents"
  "claude"
  "contributing"
  "license"
  "licence"
  "changelog"
  "changes"
  "history"
  "release-notes"
  "release_notes"
  "releasenotes"
]

let allowedMarkdownDirectories: [String!]! = [
  "docs"
  "testdata"
  "fixtures"
  "fixture"
  "__fixtures__"
  "test-fixtures"
  "test_fixtures"
  "testfixtures"
]

let markdownName(path: String!): String! {
  let parts = path.split("/")
  parts[parts.length - 1]!
}

let isMarkdownPath(path: String!): Boolean! {
  let name = markdownName(path).toLower
  markdownExtensions.any { ext => name.hasSuffix(ext) }
}

let markdownStem(path: String!): String! {
  let name = markdownName(path).toLower
  let ext = markdownExtensions.filter { e => name.hasSuffix(e) }
  name.trimSuffix(ext[0]!)
}

let isAllowedMarkdown(path: String!): Boolean! {
  allowedMarkdownStems.contains(markdownStem(path)) or path.split("/").dropLast.any { part => allowedMarkdownDirectories.contains(part.toLower) }
}

let markdownMessage = "internal markdown is not allowed; delete it, or name it in the weeds.toml markdown allowlist"

let markdownFinding(path: String!): Finding! {
  Finding(path: path, line: 1, rule: markdownRule, message: markdownMessage)
}

# files are the markdown files the shared listing returns for markdownGlobs;
# the extension test stays so that the rule never depends on the glob alone.
let markdownCandidates(files: [String!]!): [Finding!]! {
  files.filter { path => isMarkdownPath(path) and !isAllowedMarkdown(path) }.map { path => markdownFinding(path) }
}

let markdownFindings(files: [String!]!, settings: Settings!): [Finding!]! {
  let candidates = markdownCandidates(files)
  let split = unmatchedPaths(settings.allowlist, candidates.map { f => f.path })
  let unlisted = split.unmatched.map { path => markdownFinding(path) }
  let stale = split.unused.map { glob =>
    staleFinding("stale-allowlist", settings.allowlistLine, "markdown allowlist entry " + quoted(glob) + " matches no markdown file that needs it; remove it")
  }
  sortFindings(applyExceptions("markdown", unlisted, settings) + stale)
}
