let astGrepVersion = "0.39.5"

let astGrepBaseImage = "python:3.13.18-slim-trixie@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90"

let tsxFileGlobs = "\nlanguageGlobs:\n  tsx:\n    - \"*.js\"\n    - \"*.jsx\"\n    - \"*.mjs\"\n    - \"*.cjs\"\n"

let scanArguments: [String!]! = ["ast-grep", "scan", "--config", "/pack/sgconfig.yml", "--json=compact", "--no-ignore", "hidden", "--no-ignore", "dot", "--no-ignore", "vcs", "--no-ignore", "exclude", "--no-ignore", "global", "--no-ignore", "parent", "."]

let tsxExtensions: [String!]! = [".tsx", ".js", ".jsx", ".mjs", ".cjs"]

let commentGlobs: [String!]! = ["**/*.go", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"]

# Run on the uploaded copy, which holds nothing but source files. The first
# expression keeps a consumer's own ast-grep-ignore directives from hiding a
# comment from the rules. The second puts a //weeds-nl line before every line
# but the first, which makes line breaks visible to the rules: two adjacent
# markers are a blank line, and a comment whose previous sibling is not a marker
# has code before it on its line. Original line n becomes line 2n.
let markSources = "find . -type f -print0 | xargs -0 -r sed -i -e 's/ast-grep-ignore/ast_grep_ignore/g' -e '1!s#^#//weeds-nl\\n#'"

let astGrepTool: Container! {
  container
    .from(astGrepBaseImage)
    .withExec(["pip", "install", "--no-cache-dir", "--disable-pip-version-check", "ast-grep-cli==" + astGrepVersion])
}

let rulePackSource(name: String!): Directory! {
  currentModule.source.directory("rules/" + name)
}

let tsxRulePack(typescript: Directory!): Directory! {
  let pack = typescript
  ["rules", "utils"].each { folder =>
    typescript.entries(path: folder).each { entry =>
      let file = folder + "/" + entry.trimSuffix("/")
      pack = pack.withNewFile(file, typescript.file(file).contents.replace("language: TypeScript", "language: Tsx"))
    }
  }
  pack.withNewFile("sgconfig.yml", typescript.file("sgconfig.yml").contents + tsxFileGlobs)
}

let hasTsxExtension(path: String!): Boolean! {
  tsxExtensions.any { ext => path.hasSuffix(ext) }
}

let markedSources(tree: Directory!): Container! {
  astGrepTool
    .withDirectory("/work", tree)
    .withWorkdir("/work")
    .withExec(["sh", "-c", markSources])
}

# One ast-grep run of a rule pack over the marked sources. Lines come back as
# the lines of the original files.
let scanWithPack(marked: Container!, pack: Directory!): [SgMatch!]! {
  let ran = marked
    .withDirectory("/pack", pack)
    .withExec(scanArguments, redirectStderr: "/stderr.txt")
  let complaints = ran.file("/stderr.txt").contents
  if (complaints.trimSpace != "") {
    raise "comments: ast-grep reported errors:\n" + complaints
  }
  (JSON.decode(ran.stdout) :: [SgMatch!]!).map { m =>
    SgMatch(
      file: m.file.trimPrefix("./")
      ruleId: m.ruleId
      range: SgRange(start: SgPoint(line: m.range.start.line / 2, column: m.range.start.column))
    )
  }
}

# The matches of each pack that has files to scan: Go, TypeScript and the TSX
# pack derived from it, one ast-grep run each.
let scanComments(upload: Upload!): [SgMatch!]! {
  let hasGo = upload.files.any { f => f.hasSuffix(".go") }
  let hasTs = upload.files.any { f => f.hasSuffix(".ts") }
  let hasTsx = upload.files.any { f => hasTsxExtension(f) }
  if (!hasGo and !hasTs and !hasTsx) {
    return []
  }
  let marked = markedSources(upload.tree)
  let found: [SgMatch!]! = []
  if (hasGo) {
    found += scanWithPack(marked, rulePackSource("go"))
  }
  if (hasTs) {
    found += scanWithPack(marked, rulePackSource("typescript"))
  }
  if (hasTsx) {
    found += scanWithPack(marked, tsxRulePack(rulePackSource("typescript")))
  }
  found.filter { m => checkCommentRule(m.ruleId) and !commentIgnoredRules.contains(m.ruleId) }
}

# Matches by file in one pass: each match is linked to the next match of its
# file, so the lists are cut out without filtering the matches once per file.
let groupByFile(matches: [SgMatch!]!): Map[[SgMatch!]!]! {
  let first: Map[Int!]! = [:]
  let last: Map[Int!]! = [:]
  let size: Map[Int!]! = [:]
  let link: Map[Int!]! = [:]
  matches.each { m, index =>
    if (first.has(m.file)) {
      link = link.with(toString(last[m.file]!), index)
      size = size.with(m.file, size[m.file]! + 1)
    } else {
      first = first.with(m.file, index)
      size = size.with(m.file, 1)
    }
    last = last.with(m.file, index)
  }
  let groups: Map[[SgMatch!]!]! = [:]
  first.keys.each { file =>
    let at = first[file]!
    groups = groups.with(file, "".padLeft(size[file]!).split("").map { slot =>
      let hit = matches[at]!
      at = link[toString(at)] ?? at
      hit
    })
  }
  groups
}

# The comments check on the Go and TS/JS files the shared upload helper holds:
# one listing for the upload, one ast-grep run per pack, no file read.
let commentsFor(files: FileAccess!): [Finding!]! {
  let groups = groupByFile(scanComments(files.upload(commentGlobs)))
  concatFindings(groups.keys.map { path => commentFindings(path, groups[path] ?? []) })
}
