type SuppressionDirective {
  rule: String!
  pattern: String!
  shown: String!
}

let suppressionDirectives: [SuppressionDirective!]! = [
  SuppressionDirective(rule: "nolint", pattern: `//\s*nolint\b`, shown: "//nolint")
  SuppressionDirective(rule: "lint-ignore", pattern: `\blint:ignore\b`, shown: "lint:ignore")
  SuppressionDirective(rule: "eslint-disable", pattern: `\beslint-disable\b`, shown: "eslint-disable")
  SuppressionDirective(rule: "ts-expect-error", pattern: `@ts-expect-error\b`, shown: "@ts-expect-error")
  SuppressionDirective(rule: "ts-ignore", pattern: `@ts-ignore\b`, shown: "@ts-ignore")
  SuppressionDirective(rule: "ts-nocheck", pattern: `@ts-nocheck\b`, shown: "@ts-nocheck")
  SuppressionDirective(rule: "ast-grep-ignore", pattern: `\bast-grep-ignore\b`, shown: "ast-grep-ignore")
  SuppressionDirective(rule: "noqa", pattern: `(?i:#\s*noqa\b)`, shown: "# noqa")
]

let suppressionMessage(directive: SuppressionDirective!): String! {
  "inline suppression " + directive.shown + " is not allowed; fix the code, or name an exception in weeds.toml"
}

let anySuppression: String! = suppressionDirectives.map { d => d.pattern }.join("|")

type SuppressionHit {
  path: String!
  line: Int!
  text: String!
}

let suppressionSearchScript = """
set -e
find . -xtype f -print0 | xargs -0 -r sh -c 'LC_ALL=C grep -HnaPZ -e "$0" -- "$@"; [ $? -le 1 ]' "$1" > /tmp/hits
tr '\000' '\001' < /tmp/hits
"""

let suppressionSearch(scan: Directory!): [SuppressionHit!]! {
  let ran = container.from(astGrepBaseImage)
    .withDirectory("/work", scan)
    .withWorkdir("/work")
    .withNewFile("/search.sh", suppressionSearchScript)
    .withExec(["sh", "/search.sh", anySuppression])
  ran.stdout.split("\n").filter { row => row != "" }.map { row =>
    let m = row.match(`^\./(?P<path>[^\x01]*)\x01(?P<line>[0-9]+):(?P<text>.*)$`)
    if (m == null) {
      raise "suppressions: unreadable search result: " + row
    }
    SuppressionHit(path: m!.named["path"]!, line: parseInt(m!.named["line"]!), text: m!.named["text"]!)
  }
}

let suppressionHits(scan: Directory!, files: [String!]!): [Finding!]! {
  if (files.isEmpty) {
    []
  } else {
    let hits = suppressionSearch(scan)
    suppressionDirectives.map { directive =>
      hits.filter { hit => hit.text.containsMatch(`${directive.pattern}`) }.map { hit =>
        Finding(path: hit.path, line: hit.line, rule: directive.rule, message: suppressionMessage(directive))
      }
    }.reduce([] :: [Finding!]!) { all, part => all + part }
  }
}
