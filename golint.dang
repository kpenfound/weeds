let goLintImage: String! = "golangci/golangci-lint:v2.15.0@sha256:fbfcfd12a6f8d7f1b97b3362ca80fc2a244d46863148c73cb88e7793af96c481"

let goLintSource = "/src"

let goLintPresetPath = "/weeds/golangci.yml"

let correctnessLinters: [String!]! = ["errcheck", "govet", "ineffassign", "staticcheck"]

let deadCodeLinters: [String!]! = ["unused"]

let todoLinters: [String!]! = ["godox"]

let complexityLinters: [String!]! = ["funlen", "gocognit", "nestif", "dupl"]

let goLintLinters: [String!]! = correctnessLinters + deadCodeLinters + todoLinters + complexityLinters

let goLintPresetHead: [String!]! = [
  "version: \"2\""
  "linters:"
  "  default: none"
  "  enable:"
]

let goLintPresetTail: [String!]! = [
  "  settings:"
  "    funlen:"
  "      lines: 60"
  "      statements: 40"
  "    gocognit:"
  "      min-complexity: 15"
  "    nestif:"
  "      min-complexity: 4"
  "    dupl:"
  "      threshold: 80"
  "issues:"
  "  max-issues-per-linter: 0"
  "  max-same-issues: 0"
  "  uniq-by-line: false"
]

let goLintPreset: String! = (goLintPresetHead + goLintLinters.map { name => "    - " + name } + goLintPresetTail).join("\n") + "\n"

let goLintInertNolint = "grep -rlE --include='*.go' --exclude-dir=.git --exclude-dir=node_modules '//[[:space:]]*nolint' " + goLintSource + " | xargs -r sed -i -E 's#//[[:space:]]*nolint#//weeds-inert-nolint#g'"

let lastPart(path: String!): String! {
  let parts = path.split("/")
  parts[parts.length - 1]!
}

let parentDirectory(path: String!): String! {
  let parts = path.split("/")
  if (parts.length == 1) {
    "."
  } else {
    parts.dropLast.join("/")
  }
}

let goLintCandidate(path: String!): Boolean! {
  !path.split("/").any { part => part == "testdata" }
}

let moduleDepth(module: String!): Int! {
  if (module == ".") {
    0
  } else {
    module.length
  }
}

let owningModule(modules: [String!]!, dir: String!): String! {
  let best = ""
  let found = false
  modules.each { module =>
    if (module == "." or dir == module or dir.hasPrefix(module + "/")) {
      if (!found or moduleDepth(module) > moduleDepth(best)) {
        best = module
        found = true
      }
    }
  }
  best
}

let goModules(files: [String!]!): [String!]! {
  let candidates = files.filter { path => goLintCandidate(path) }
  let modules = sortStrings(candidates.filter { path => lastPart(path) == "go.mod" }.map { path => parentDirectory(path) })
  let sourceDirectories = candidates.filter { path => path.hasSuffix(".go") }.map { path => parentDirectory(path) }.uniq
  let used = sourceDirectories.map { dir => owningModule(modules, dir) }
  modules.filter { module => used.contains(module) }
}

let goLintBase(source: Directory!): Container! {
  container
    .from(goLintImage)
    .withMountedCache("/go/pkg/mod", cacheVolume("weeds-go-mod"))
    .withEnvVariable("GOMODCACHE", "/go/pkg/mod")
    .withMountedCache("/go/build-cache", cacheVolume("weeds-go-build"))
    .withEnvVariable("GOCACHE", "/go/build-cache")
    .withMountedCache("/go/lint-cache", cacheVolume("weeds-golangci-lint"))
    .withEnvVariable("GOLANGCI_LINT_CACHE", "/go/lint-cache")
    .withEnvVariable("GOFLAGS", "-mod=mod")
    .withEnvVariable("GOTOOLCHAIN", "local")
    .withDirectory(goLintSource, source.filter(exclude: [".git", "**/.git"]))
    .withNewFile(goLintPresetPath, goLintPreset)
    .withExec(["sh", "-c", goLintInertNolint])
}

let moduleLabel(module: String!): String! {
  if (module == ".") {
    ". (the workspace root)"
  } else {
    module
  }
}

let goLintArguments: [String!]! = [
  "golangci-lint", "run",
  "--config", goLintPresetPath,
  "--issues-exit-code", "0",
  "--show-stats=false",
  "--path-mode=abs",
  "--output.json.path=stdout",
]

let runGoLint(base: Container!, module: String!): Container! {
  let workdir = if (module == ".") { goLintSource } else { goLintSource + "/" + module }
  base.withWorkdir(workdir).withExec(goLintArguments, expect: ReturnType.ANY)
}

let declaredSymbol(row: String!): String! {
  let method = row.match(`^func\s*\(\s*(?:\w+\s+)?\*?\s*(?P<recv>\w+)(?:\[[^\]]*\])?\s*\)\s*(?P<name>\w+)`)
  let plain = row.match(`^(?:func|var|const|type)\s+(?P<name>\w+)`)
  if (method != null) {
    method!.named["recv"]! + "." + method!.named["name"]!
  } else if (plain != null) {
    plain!.named["name"]!
  } else {
    "(none)"
  }
}

let goSymbol(rows: [String!]!, line: Int!): String! {
  let at = if (line > rows.length) { rows.length - 1 } else { line - 1 }
  let symbol = "(none)"
  loop {
    if (at < 0) {
      break
    }
    if (rows[at]!.containsMatch(`^(?:func|var|const|type)\b`)) {
      symbol = declaredSymbol(rows[at]!)
      break
    }
    at = at - 1
  }
  symbol
}

let baselineNote(symbol: String!): String! {
  " (baseline symbol " + quoted(symbol) + ")"
}

let baselineSymbolOf(finding: Finding!): String! {
  let m = finding.message.match(`\(baseline symbol "(?P<symbol>[^"]*)"\)$`)
  if (m == null) {
    ""
  } else {
    m!.named["symbol"]!
  }
}

type GoLintPosition {
  Filename: String
  Line: Int
}

type GoLintIssue {
  FromLinter: String
  Text: String
  Pos: GoLintPosition
}

type GoLintOutput {
  Issues: [GoLintIssue]
}

type GoLintListed {
  Issues: [GoLintIssue]!
}

type GoLintDecoded {
  issues: [GoLintIssue]! = []
  failedAt: Int! = -1
  problem: String! = ""
}

# The decoder takes each member only as its declared type. Weeds has always read
# a bare number, true, false or null in FromLinter, Text or Filename as that
# text, and a Pos.Line only when it is plain digits. These rewrites give the
# decoder the same reading: such scalars become strings, an array or object in
# those members reads as absent (empty text), and a Pos that is not an object or
# a Line that is not plain digits reads as absent, which the issue check reports.
# The last rewrite doubles every backslash that starts an escape, so the decoder
# hands back each string exactly as written between its quotes. unescapeJson then
# turns it into text, which keeps the output byte for byte what it has always
# been: it knows only a few escapes, leaves the rest as typed, and applies them
# in its own order.
let goLintDecodable(output: String!): String! {
  output
    .replaceMatches(`"(FromLinter|Text|Filename)"(\s*:\s*)(-?[0-9][-0-9.eE+]*|true|false|null)`, "\"${1}\"${2}\"${3}\"")
    .replaceMatches(`"(FromLinter|Text|Filename)"(\s*:\s*)([\[{])`, "\"${1}Hidden\"${2}${3}")
    .replaceMatches(`"Pos"(\s*:\s*)([^{\s])`, "\"PosHidden\"${1}${2}")
    .replaceMatches(`"Line"(\s*:\s*)([^0-9\s])`, "\"LineHidden\"${1}${2}")
    .replaceMatches(`"Line"(\s*:\s*)([0-9]+)([.eE])`, "\"LineHidden\"${1}${2}${3}")
    .replaceMatches(`(\\)(["\\])|\\([^"\\])`, "\\\\${1}${2}${3}")
}

let goLintOutputIssues(text: String!): GoLintOutput! {
  JSON.decode(text)
}

let goLintListedIssues(text: String!): GoLintListed! {
  JSON.decode(text)
}

let goLintDecodeFailure(message: String!): GoLintDecoded! {
  let m = message.match(`^Issues\[(?P<index>[0-9]+)\]`)
  if (m != null) {
    GoLintDecoded(failedAt: parseInt(m!.named["index"]!))
  } else if (message.hasPrefix("Issues")) {
    GoLintDecoded(problem: "unreadable")
  } else {
    GoLintDecoded(problem: "json")
  }
}

let goLintDecodeOutput(text: String!): GoLintDecoded! {
  let decoded = {
    let doc = goLintOutputIssues(text)
    if (doc.Issues == null) {
      GoLintDecoded(problem: "null")
    } else {
      GoLintDecoded(issues: doc.Issues!)
    }
  } rescue { err: Error => goLintDecodeFailure(err.message) }
  if (decoded.problem == "null") {
    let listed = { goLintListedIssues(text); GoLintDecoded() } rescue { err: Error =>
      if (err.message.contains("missing required field")) {
        GoLintDecoded(problem: "absent")
      } else {
        GoLintDecoded()
      }
    }
    listed
  } else {
    decoded
  }
}

let goLintIssueMessage(module: String!, index: Int!): String! {
  "go-lint: golangci-lint output for module " + moduleLabel(module) + " has an issue without a linter, file or line: Issues[" + toString(index) + "]"
}

let goLintFinding(module: String!, issue: GoLintIssue, index: Int!): Finding! {
  let label = moduleLabel(module)
  let linter = unescapeJson(issue.FromLinter ?? "")
  let text = unescapeJson(issue.Text ?? "").replace("\n", " ")
  let file = unescapeJson(issue.Pos.Filename ?? "")
  let reported = issue.Pos.Line ?? -1
  if (linter == "" or file == "" or reported < 0) {
    raise goLintIssueMessage(module, index)
  }
  let line = if (reported < 1) { 1 } else { reported }
  if (linter == "typecheck") {
    raise "go-lint: golangci-lint could not build module " + label + " (" + file + ":" + toString(line) + "): " + text
  }
  if (!goLintLinters.contains(linter)) {
    raise "go-lint: golangci-lint reported an issue from linter " + quoted(linter) + ", which Weeds does not register (module " + label + ", " + file + ":" + toString(line) + ")"
  }
  let prefix = goLintSource + "/"
  if (!file.hasPrefix(prefix)) {
    raise "go-lint: golangci-lint reported a file outside the workspace in module " + label + ": " + file
  }
  let path = file.trimPrefix(prefix)
  let shown = if (module == ".") { text } else { text.replace("duplicate of `", "duplicate of `" + module + "/") }
  Finding(path: path, line: line, rule: linter, message: shown)
}

let goLintRaiseIssue(module: String!, index: Int!): [Finding!]! {
  [index].map { failed => raise goLintIssueMessage(module, failed) }
}

let goLintSymbols(source: Directory!, found: [Finding!]!): [Finding!]! {
  let rows: Map[[String!]!]! = [:]
  found.each { f =>
    if (complexityLinters.contains(f.rule) and !rows.has(f.path)) {
      rows = rows.with(f.path, source.file(f.path).contents.split("\n"))
    }
  }
  found.map { f =>
    if (complexityLinters.contains(f.rule)) {
      Finding(path: f.path, line: f.line, rule: f.rule, message: f.message + baselineNote(goSymbol(rows[f.path]!, f.line)))
    } else {
      f
    }
  }
}

let goLintIssues(source: Directory!, module: String!, output: String!): [Finding!]! {
  let label = moduleLabel(module)
  let shown = output.trimSpace
  if (!shown.hasPrefix("{") or !shown.hasSuffix("}")) {
    raise "go-lint: golangci-lint output for module " + label + " is not readable JSON: " + shown
  }
  let decoded = goLintDecodeOutput(goLintDecodable(shown))
  if (decoded.problem == "absent") {
    raise "go-lint: golangci-lint output for module " + label + " has no Issues list"
  } else if (decoded.problem == "unreadable") {
    raise "go-lint: golangci-lint output for module " + label + " has an unreadable Issues list"
  } else if (decoded.problem == "json") {
    raise "go-lint: golangci-lint output for module " + label + " is not readable JSON: " + shown
  } else if (decoded.failedAt >= 0) {
    goLintRaiseIssue(module, decoded.failedAt)
  } else {
    goLintSymbols(source, decoded.issues.map { issue, index => goLintFinding(module, issue, index) })
  }
}

let goLintProcessFindings(source: Directory!, module: String!, status: Int!, stdout: String!, stderr: String!): [Finding!]! {
  if (status != 0) {
    raise "go-lint: golangci-lint exited with status " + toString(status) + " in module " + moduleLabel(module) + ":\n" + stderr.trimSpace + "\n" + stdout.trimSpace
  }
  goLintIssues(source, module, stdout)
}

let lintModule(source: Directory!, base: Container!, module: String!): [Finding!]! {
  let ran = runGoLint(base, module)
  goLintProcessFindings(source, module, ran.exitCode, ran.stdout, ran.stderr)
}

let joinFindings(lists: [[Finding!]!]!): [Finding!]! {
  if (lists.length == 0) {
    []
  } else if (lists.length == 1) {
    lists[0]!
  } else {
    let middle = lists.length / 2
    joinFindings(lists.takeFirst(middle)) + joinFindings(lists.dropFirst(middle))
  }
}

let goLintHits(source: Directory!, files: [String!]!): [Finding!]! {
  let modules = goModules(files)
  if (modules.isEmpty) {
    []
  } else {
    let base = goLintBase(source)
    joinFindings(modules.map { module => lintModule(source, base, module) })
  }
}

let baselineLabel(entry: BaselineEntry!): String! {
  entry.linter + " in " + entry.path + (if (entry.symbol == "") { "" } else { " symbol " + quoted(entry.symbol) })
}

type BaselineVerdict {
  finding: Finding!
  matched: [Int!]!
}

let baselineKey(linter: String!, path: String!): String! {
  linter + "\x01" + path
}

let goLintBaselined(hits: [Finding!]!, settings: Settings!): {{ remaining: [Finding!]!, stale: [Finding!]! }}! {
  if (settings.baseline.isEmpty) {
    let none: [Finding!]! = []
    {{
      remaining: hits
      stale: none
    }}
  } else {
    let entries = settings.baseline
    let symbols = entries.map { entry => entry.symbol }
    let buckets: Map[[Int!]!]! = [:]
    entries.each { entry, index =>
      let key = baselineKey(entry.linter, entry.path)
      buckets = buckets.with(key, (buckets[key] ?? []) + [index])
    }
    let verdicts = hits.map { f =>
      let bucket = buckets[baselineKey(f.rule, f.path)]
      if (bucket == null) {
        BaselineVerdict(finding: f, matched: [])
      } else {
        let symbol = baselineSymbolOf(f)
        BaselineVerdict(finding: f, matched: bucket!.filter { index => symbols[index]! == "" or symbols[index]! == symbol })
      }
    }
    let used = "," + verdicts.map { v => v.matched.join(",") }.join(",") + ","
    {{
      remaining: verdicts.filter { v => v.matched.isEmpty }.map { v => v.finding }
      stale: joinFindings(entries.map { entry, index =>
        if (used.contains("," + toString(index) + ",")) {
          []
        } else {
          [staleFinding("stale-baseline", entry.line, "baseline entry for " + baselineLabel(entry) + " matches no finding; remove it")]
        }
      })
    }}
  }
}

let goLintOutcomeOf(hits: [Finding!]!, settings: Settings!): [Finding!]! {
  let baselined = goLintBaselined(hits, settings)
  sortFindings(applyExceptions("go-lint", baselined.remaining, settings) + baselined.stale)
}

let goLintFindings(source: Directory!, files: [String!]!, settings: Settings!): [Finding!]! {
  goLintOutcomeOf(goLintHits(source, files), settings)
}
