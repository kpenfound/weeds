let skillsRepository = "https://github.com/kpenfound/skills"

let skillsCommit = "295e8f78fe22a041b23674e96014c5d6e6778e02"

let fetchSkills(): Directory! {
  git(skillsRepository).commit(skillsCommit).tree
}

let skillFile = "SKILL.md"

let skillAdded = "skill-added"

let skillModified = "skill-modified"

let skillRemoved = "skill-removed"

let skillConflict = "skill-conflict"

let fallbackAgents: [String!]! = [".agents", ".claude"]

let instructionFile(agent: String!): String! {
  if (agent == ".agents") {
    "AGENTS.md"
  } else {
    "CLAUDE.md"
  }
}

let skillTargets(source: Directory!): [String!]! {
  let existing = skillsDirectories.filter { target =>
    isRealDirectory(source, target.trimSuffix("/skills")) and isRealDirectory(source, target)
  }
  if (existing.isEmpty) {
    fallbackAgents
      .filter { agent =>
        let free = !source.exists(agent, doNotFollowSymlinks: true)
        source.exists(instructionFile(agent), expectedType: ExistsType.REGULAR_TYPE) and
          (free or isRealDirectory(source, agent)) and
          !source.exists(agent + "/skills", doNotFollowSymlinks: true)
      }
      .map { agent => agent + "/skills" }
  } else {
    existing
  }
}

let frontmatterName(text: String!): String! {
  let lines = text.split("\n").map { row => row.trimSuffix("\r") }
  let name = ""
  let inside = false
  let closed = false
  lines.each { row, index =>
    if (index == 0) {
      inside = row.trimSpace == "---"
    } else if (inside and !closed) {
      if (row.trimSpace == "---") {
        closed = true
      } else if (name == "" and row.hasPrefix("name:")) {
        name = row.trimPrefix("name:").trimSpace.trimPrefix("\"").trimSuffix("\"").trimPrefix("'").trimSuffix("'").trimSpace
      }
    }
  }
  if (closed) {
    name
  } else {
    ""
  }
}

let skillProblem(tree: Directory!, name: String!): String! {
  if (!isRealDirectory(tree, name)) {
    "skill " + quoted(name) + " is missing from the skill source"
  } else if (!isRealFile(tree, name + "/" + skillFile)) {
    "skill " + quoted(name) + " has no " + skillFile
  } else {
    let declared = frontmatterName(tree.file(name + "/" + skillFile).contents)
    if (declared != name) {
      "skill " + quoted(name) + ": frontmatter name " + quoted(declared) + " must equal the folder name"
    } else {
      ""
    }
  }
}

let skillProblems(tree: Directory!, names: [String!]!): [String!]! {
  names.map { name => skillProblem(tree, name) }.filter { problem => problem != "" }
}

let checkSkillSource(tree: Directory!, names: [String!]!): Void {
  let problems = skillProblems(tree, names)
  if (!problems.isEmpty) {
    raise "the skill source is invalid:\n- " + problems.join("\n- ")
  }
  null
}

let isOwnedFolder(source: Directory!, folder: String!): Boolean! {
  isRealDirectory(source, folder) and isRealFile(source, folder + "/" + markerFile) and isOwnerMarker(source.file(folder + "/" + markerFile).contents)
}

let joinStrings(lists: [[String!]!]!): [String!]! {
  if (lists.length == 0) {
    []
  } else if (lists.length == 1) {
    lists[0]!
  } else {
    let middle = lists.length / 2
    joinStrings(lists.takeFirst(middle)) + joinStrings(lists.dropFirst(middle))
  }
}

let installConflicts(source: Directory!, targets: [String!]!, names: [String!]!): [String!]! {
  sortStrings(joinStrings(targets.map { target =>
    names
      .map { name => target + "/" + name }
      .filter { folder => source.exists(folder, doNotFollowSymlinks: true) and !isOwnedFolder(source, folder) }
  }))
}

let unselectedFolders(source: Directory!, targets: [String!]!, names: [String!]!): [String!]! {
  sortStrings(joinStrings(targets.map { target =>
    if (isRealDirectory(source, target)) {
      source.entries(path: target)
        .map { entry => entry.trimSuffix("/") }
        .filter { name => !names.contains(name) and isOwnedFolder(source, target + "/" + name) }
        .map { name => target + "/" + name }
    } else {
      []
    }
  }))
}

let installedTree(source: Directory!, tree: Directory!, targets: [String!]!, names: [String!]!): Directory! {
  let installed = targets.reduce(source) { output, target =>
    names.reduce(output) { inner, name =>
      let folder = target + "/" + name
      inner
        .withoutDirectory(folder)
        .withDirectory(folder, tree.directory(name))
        .withNewFile(folder + "/" + markerFile, markerContent)
    }
  }
  unselectedFolders(source, targets, names).reduce(installed) { output, folder =>
    output.withoutDirectory(folder)
  }
}

let installChanges(source: Directory!, tree: Directory!, targets: [String!]!, names: [String!]!): Changeset! {
  let conflicts = installConflicts(source, targets, names)
  if (!conflicts.isEmpty) {
    raise "dagger generate aborted with no change; these folders exist without the Weeds ownership marker, so move or delete them:\n- " + conflicts.join("\n- ")
  }
  installedTree(source, tree, targets, names).changes(source)
}

let conflictFindings(conflicts: [String!]!): [Finding!]! {
  conflicts.map { folder =>
    Finding(path: folder, line: 1, rule: skillConflict, message: "folder exists without the Weeds ownership marker, so dagger generate would abort; move or delete it")
  }
}

let removedFiles(changes: Changeset!): [String!]! {
  joinStrings(changes.removedPaths.map { path =>
    if (path.hasSuffix("/")) {
      let folder = path.trimSuffix("/")
      changes.before.directory(folder).glob("**/*").filter { inner => !inner.hasSuffix("/") }.map { inner => folder + "/" + inner }
    } else {
      [path]
    }
  })
}

let changeFindings(changes: Changeset!): [Finding!]! {
  let added = changes.addedPaths.filter { path => !path.hasSuffix("/") }.map { path =>
    Finding(path: path, line: 1, rule: skillAdded, message: "missing; dagger generate would add it")
  }
  let modified = changes.modifiedPaths.filter { path => !path.hasSuffix("/") }.map { path =>
    Finding(path: path, line: 1, rule: skillModified, message: "differs from the installer output; dagger generate would restore it")
  }
  let removed = removedFiles(changes).map { path =>
    Finding(path: path, line: 1, rule: skillRemoved, message: "not part of the installer output; dagger generate would remove it")
  }
  added + modified + removed
}
