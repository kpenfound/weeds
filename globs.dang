let regexSpecials = ["\\", ".", "+", "(", ")", "|", "[", "]", "{", "}", "^", "$"]

let escapeRegexp(text: String!): String! {
  regexSpecials.reduce(text) { escaped, ch => escaped.replace(ch, "\\" + ch) }
}

# classes keeps [...] as a character class (the file layer's include globs use
# it for case-insensitive extensions); weeds.toml path globs never do.
let globRegexp(glob: String!, classes: Boolean!): String! {
  let trimmed = glob.trimPrefix("./").trimSuffix("/")
  let marked = if (classes) { trimmed.replace("[", "\x05").replace("]", "\x06") } else { trimmed }
  let body = escapeRegexp(marked.replace("**/", "\x01").replace("**", "\x02").replace("*", "\x03").replace("?", "\x04"))
  "^" + body.replace("\x01", "(?:.*/)?").replace("\x02", ".*").replace("\x03", "[^/]*").replace("\x04", "[^/]").replace("\x05", "[").replace("\x06", "]") + "(?:/.*)?$"
}

let globPattern(glob: String!): String! {
  globRegexp(glob, false)
}

let globPatterns(globs: [String!]!): [String!]! {
  globs.map { glob => globPattern(glob) }
}

let patternMatches(pattern: String!, path: String!): Boolean! {
  path.containsMatch(`${pattern}`)
}

let pathMatches(glob: String!, path: String!): Boolean! {
  patternMatches(globPattern(glob), path)
}

let unmatchedPaths(globs: [String!]!, paths: [String!]!): {{ unmatched: [String!]!, unused: [String!]! }}! {
  let patterns = globPatterns(globs)
  let used: Map[Boolean!]! = [:]
  let unmatched = paths.filter { path =>
    let covered = false
    patterns.each { pattern, index =>
      if ((!covered or !used.has(globs[index]!)) and patternMatches(pattern, path)) {
        covered = true
        used = used.with(globs[index]!, true)
      }
    }
    !covered
  }
  {{ unmatched: unmatched, unused: globs.filter { glob => !used.has(glob) } }}
}
